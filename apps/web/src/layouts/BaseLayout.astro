---
import "@/styles/globals.css";
import RinggWidget from "../components/RinggWidget.astro";
export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogUrl?: string;
  robots?: string;
}

const {
  title = "Amberly Digital | AI Automation & Custom AI Solutions",
  description = "Amberly Digital builds AI receptionists, workflow automation systems, and custom AI tools for businesses worldwide.",
  ogTitle = "Amberly Digital | AI Automation & Custom AI Solutions",
  ogDescription = "AI receptionists, workflow automation, custom AI tools, and websites designed to help businesses grow with less manual work.",
  ogType = "website",
  ogUrl,
  robots = "index, follow",
} = Astro.props;

// Determine current canonical URL dynamically
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site || "https://amberlydigital.com",
).toString();

const publicApiUrl = import.meta.env.PUBLIC_API_URL;
const publicLocalApiUrl = import.meta.env.PUBLIC_LOCAL_API_URL;

// Ringg.AI widget: exclude /ai-studio and /blog routes (and all their sub-pages)
const showRinggWidget =
  !Astro.url.pathname.startsWith('/ai-studio') &&
  !Astro.url.pathname.startsWith('/blog');

// Ringg.AI credentials — sourced from .env (PUBLIC_ prefix required for Astro/Vite to expose them)
const ringgAgentId = import.meta.env.PUBLIC_RINGG_AGENT_ID;
const ringgApiKey = import.meta.env.PUBLIC_RINGG_API_KEY;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Amberly Digital" />

    <!-- Robots Meta -->
    <meta name="robots" content={robots} />

    <!-- Canonical URL Link -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl || canonicalUrl} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content="https://amberlydigital.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="https://amberlydigital.com/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts: Inter + Outfit + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- PERF_OPT: Async font loading to eliminate render-blocking. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- CSS variable injection for font families (mirrors next/font/google variables) -->
    <style>
      :root {
        --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
        --font-display: "Outfit", sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
      }
    </style>

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-9RVKRYLSBV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-9RVKRYLSBV");
    </script>

    <!-- Warm up hosted backend (Render spin-up) and sync user session on load -->
    {(publicApiUrl || publicLocalApiUrl) && (
      <script define:vars={{ publicApiUrl, publicLocalApiUrl }}>
        document.addEventListener("DOMContentLoaded", () => {
          const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
          const activeApiUrl = (isLocal && publicLocalApiUrl && publicLocalApiUrl !== 'undefined') ? publicLocalApiUrl : publicApiUrl;

          if (activeApiUrl) {
            // Asynchronously wake up the backend if sleeping
            fetch(`${activeApiUrl}/health`).catch(() => {});

            // Fetch fresh user profile to sync localStorage with backend session
            fetch(`${activeApiUrl}/users/me`, { credentials: 'include' })
              .then(res => {
                if (res.ok) {
                  return res.json();
                } else if (res.status === 401) {
                  localStorage.removeItem('user_profile');
                  localStorage.removeItem('user_tasks');
                }
                return null;
              })
              .then(data => {
                if (data) {
                  const userPayload = data.data || data;
                  const name = userPayload.name || userPayload.full_name || userPayload.user?.name || userPayload.user?.full_name || userPayload.email?.split('@')[0] || userPayload.user?.email?.split('@')[0] || 'User';
                  const avatar = userPayload.avatar_url || userPayload.picture || userPayload.user?.avatar_url || userPayload.user?.picture || null;
                  localStorage.setItem('user_profile', JSON.stringify({ name, avatar }));
                  
                  // Dispatch event so layout can react if status was changed
                  window.dispatchEvent(new CustomEvent('authSynced', { detail: { name } }));
                }
              })
              .catch(() => {
                // If connection is refused, failed, or server is down, clear cached credentials to prevent bypasses
                localStorage.removeItem('user_profile');
                localStorage.removeItem('user_tasks');
              });
          }
        });
      </script>
    )}
  </head>
  <body
    class="antialiased geo-grid min-h-screen flex flex-col bg-slate-50 text-slate-900"
  >
    <slot />

    <!-- Smooth Scroll-Reveal script -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const observerOptions = {
          root: null,
          rootMargin: "0px 0px -10% 0px", // Trigger when 10% of element is in view
          threshold: 0.05
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("reveal-active");
              // Remove observation after reveal
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        const revealElements = document.querySelectorAll("header, section, .scroll-reveal");
        revealElements.forEach(el => observer.observe(el));
      });
    </script>


    <!-- Ringg.AI Voice/Chat Widget — see src/components/RinggWidget.astro for all logic -->
    {showRinggWidget && ringgAgentId && ringgApiKey && (
      <RinggWidget
        agentId={ringgAgentId}
        apiKey={ringgApiKey}
        apiUrl={publicApiUrl}
        localApiUrl={publicLocalApiUrl}
      />
    )}

  
  </body>
</html>
