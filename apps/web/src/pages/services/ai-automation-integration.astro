    category: "Enterprise CRM",
    color: "from-[#F0F9FF] to-white border-sky-300",
    badgeColor: "bg-sky-500 text-white",
    svgLogo: `<svg class="w-7 h-7 shrink-0" viewBox="0 0 24 24" fill="#00A1E0"><path d="M10.005 5.539a6.234 6.234 0 0 1 5.378 3.123 4.887 4.887 0 0 1 3.642 1.488 4.79 4.79 0 0 1 1.44 3.498 4.82 4.82 0 0 1-4.843 4.813H7.818A5.818 5.818 0 0 1 2 12.643a5.72 5.72 0 0 1 2.378-4.636 5.85 5.85 0 0 1 4.542-1.07 6.2 6.2 0 0 1 1.085-1.398z"/></svg>`,
  },
  {
    name: "Google Workspace",
    category: "Gmail & Calendar",
    color: "from-[#EFF6FF] to-white border-blue-300",
    badgeColor: "bg-blue-600 text-white",
    svgLogo: `<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>`,
