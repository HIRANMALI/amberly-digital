    svgLogo: `<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="#635BFF"><path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.763-1.444 2.15-1.444 1.764 0 3.125.75 3.957 1.341l.732-2.731C16.353 3.14 14.654 2.5 12.636 2.5 8.761 2.5 6.096 4.606 6.096 7.828c0 4.412 5.922 4.707 5.922 7.028 0 .977-.852 1.637-2.38 1.637-1.954 0-3.763-.984-4.705-1.688l-.752 2.766c1.233.916 3.254 1.429 5.437 1.429 4.095 0 6.945-2.021 6.945-5.466 0-4.664-5.586-4.887-5.586-7.142z"/></svg>`,
  },
  {
    name: "QuickBooks",
    category: "Accounting & Taxes",
    color: "from-[#ECFDF5] to-white border-emerald-300",
    badgeColor: "bg-emerald-600 text-white",
    svgLogo: `<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="#2CA01C"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-1.8 17.4h-2.1v-6.3c0-.993.807-1.8 1.8-1.8h2.1c.993 0 1.8.807 1.8 1.8v.3h-3.9v6zm7.5 0h-2.1v-6c0-1.986-1.614-3.6-3.6-3.6h-.3v-1.5c0-.993.807-1.8 1.8-1.8h2.1c.993 0 1.8.807 1.8 1.8v11.1z"/></svg>`,
  },
  {
    name: "Slack",
    category: "Team Messaging",
    color: "from-[#FDF2F8] to-white border-pink-300",
    badgeColor: "bg-pink-600 text-white",
    svgLogo: `<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24"><path fill="#E01E5A" d="M6 15a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5zm0-2.5a2.5 2.5 0 0 1 2.5-2.5H11v2.5A2.5 2.5 0 0 1 8.5 15H6z"/><path fill="#36C5F0" d="M9 6a2.5 2.5 0 1 1 5 0 2.5 2.5 0 0 1-5 0zm2.5 0a2.5 2.5 0 0 1 2.5 2.5V11h-2.5A2.5 2.5 0 0 1 9 8.5V6z"/><path fill="#2EB67D" d="M18 9a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zm0 2.5a2.5 2.5 0 0 1-2.5 2.5H13v-2.5A2.5 2.5 0 0 1 15.5 9H18z"/><path fill="#ECB22E" d="M15 18a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0zm-2.5 0a2.5 2.5 0 0 1-2.5-2.5V13h2.5a2.5 2.5 0 0 1 2.5 2.5V18z"/></svg>`,
  },
  {
    name: "Notion",
    category: "Docs & Workspace",
    color: "from-[#F8FAFC] to-white border-slate-400",
    badgeColor: "bg-slate-900 text-white",
    svgLogo: `<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="#000000"><path d="M4.459 4.208c.746.606 1.026.56 2.428.466l11.082-.676c.42-.047.886-.42.746-.886l-.606-.886c-.28-.373-.794-.514-1.306-.466L4.506 2.48c-.606.047-.886.373-.886.794l.839.934zm1.073 3.639v12.268c0 .84.373 1.166 1.353 1.12l11.736-.653c.98-.047 1.306-.513 1.306-1.353V6.913c0-.746-.326-1.12-1.073-1.073l-12.296.676c-.746.047-1.026.42-1.026 1.331zm10.708 1.493c.187.327.187.7.047.98l-3.36 6.301 2.986.14c.7.047.934.373.934.794s-.28.746-.746.746l-4.573-.233c-.513-.047-.7-.373-.466-.84l3.546-6.441-2.846-.14c-.653-.047-.886-.373-.886-.794s.28-.746.746-.746l4.62.233z"/></svg>`,
  },
  {
    name: "Zapier",
    category: "App Connector",
    color: "from-[#FFFBEB] to-white border-amber-300",
    badgeColor: "bg-amber-500 text-slate-950 font-bold",
    svgLogo: `<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="#FF4F00"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-1.5 17.5l1.875-5.25H7.875l4.5-8.25-1.875 5.25h4.5l-4.5 8.25z"/></svg>`,
  },
  {
    name: "Make",
    category: "Visual Automation",
    color: "from-[#FAF5FF] to-white border-purple-300",
    badgeColor: "bg-purple-600 text-white",
    svgLogo: `<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="#6D00F6"><path d="M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.8l7.2 3.6-7.2 3.6-7.2-3.6L12 4.8zM4.4 9.8l6.4 3.2v6.6l-6.4-3.2V9.8zm15.2 6.6l-6.4 3.2v-6.6l6.4-3.2v6.6z"/></svg>`,
  },
];

const automatedTasks = [
  {
    title: "Lead Capture",
    description: "Instantly parse inbound website forms, qualify prospect intent, and route high-value leads within seconds.",
    icon: Sparkles,
    color: "bg-[#FCD34D]",
  },
  {
    title: "Calendar Booking",
    description: "Automate scheduling, multi-timezone calendar coordination, and instant confirmation invites without back-and-forth emails.",
    icon: Calendar,
    color: "bg-[#87E6F9]",
  },
  {
    title: "CRM Updates",
    description: "Eliminate manual typing. Automatically update lead stages, append meeting notes, and tag customer profiles in real time.",
    icon: Database,
    color: "bg-[#A4E8D7]",
  },
  {
    title: "Invoice Generation",
    description: "Auto-generate draft invoices in QuickBooks or Xero the moment a deal closes or a project milestone is completed.",
    icon: FileText,
    color: "bg-[#F9A8D4]",
  },
  {
    title: "Email Follow-Ups",
    description: "Send context-aware AI response drafts, personalized follow-ups, and onboarding packets automatically.",
    icon: Mail,
    color: "bg-[#C084FC]",
  },
  {
    title: "Slack Notifications",
    description: "Receive instant operational alerts, revenue updates, and urgent dispatch notifications straight to your team channel.",
    icon: MessageSquare,
    color: "bg-[#A3E635]",
  },
];
---

<BaseLayout
  title="Automate Your Business Operations | AI Workflow & API Integration"
  description="Connect your CRM, calendar, emails, invoices and internal tools into one seamless AI workflow. Eliminate manual admin work with custom AI integrations."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaJson)} />

  <Navbar />

  <!-- TOP LIVE STATUS STRIP (Home Page Style) -->
  <div
    class="bg-[#FCD34D] border-b-2 border-slate-950 py-2.5 px-4 text-center text-slate-950 text-xs font-mono font-black uppercase tracking-widest flex items-center justify-center gap-2 flex-wrap"
  >
    <svg
      class="w-4 h-4 text-slate-950 fill-current animate-pulse"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M17.66 11.2C17.43 10.9 17.15 10.64 16.89 10.38C16.22 9.78 15.46 9.35 14.82 8.72C13.33 7.26 13 4.85 13.95 3C13 3.23 12.17 3.75 11.46 4.32C8.87 6.4 7.85 10.07 9.07 13.22C9.11 13.32 9.15 13.42 9.15 13.55C9.15 13.77 9 13.97 8.8 14.05C8.57 14.15 8.33 14.09 8.14 13.93C8.08 13.88 8.04 13.83 8 13.76C6.87 12.33 6.69 10.28 7.45 8.64C5.78 10 4.87 12.3 5 14.47C5.06 14.97 5.12 15.47 5.29 15.97C5.43 16.57 5.7 17.17 6 17.7C7.08 19.43 8.95 20.67 10.96 20.92C13.1 21.19 15.39 20.8 17.03 19.32C18.86 17.66 19.5 15 18.56 12.72L18.43 12.46C18.22 12 17.66 11.2 17.66 11.2Z"></path>
    </svg>
    <span>⚡ LIVE AI WORKFLOW ENGINE: DIRECT API PIPELINES ONLINE</span>
  </div>

  <main class="bg-white">
    <!-- HERO SECTION -->
    <header
      class="border-b-2 border-slate-950 bg-slate-50 py-16 lg:py-24 relative overflow-hidden"
    >
      <div class="absolute top-0 right-1/2 translate-x-1/2 w-[600px] h-[300px] bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-8xl mx-auto px-6 lg:px-12 relative z-10 text-center space-y-8">
        
        <!-- Top Pill Badges -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <span
            class="px-4 py-1.5 rounded-full text-xs font-mono font-bold border-2 border-slate-950 bg-[#FCD34D] text-slate-950 shadow-[2px_2px_0px_0px_rgba(2,6,23,1)] uppercase tracking-wider"
          >
            ⚡ AI WORKFLOW AUTOMATION
          </span>
          <span
            class="px-4 py-1.5 rounded-full text-xs font-mono font-bold border-2 border-slate-950 bg-white text-slate-950 shadow-[2px_2px_0px_0px_rgba(2,6,23,1)] uppercase tracking-wider hidden sm:inline-block"
          >
            🔒 99.9% UPTIME SLA
          </span>
        </div>

        <!-- Main Hard-Hitting Headline -->
        <h1
          class="text-4xl sm:text-6xl lg:text-7xl xl:text-8xl font-black font-display leading-none text-slate-950 uppercase tracking-tight max-w-5xl mx-auto"
        >
          Automate Your <br class="hidden sm:block" />
          <span class="text-amber-500">Business Operations.</span>
        </h1>

        <!-- Subheadline -->
        <p
          class="text-base sm:text-xl lg:text-2xl text-slate-700 font-medium max-w-3xl mx-auto leading-relaxed"
        >
          Connect your <strong>CRM, calendar, emails, invoices</strong> and internal tools into one seamless AI workflow.
        </p>

        <!-- ABOVE THE FOLD SINGLE PRIMARY CTA -->
        <div class="pt-4 flex justify-center max-w-md mx-auto">
          <a
            href="/#onboarding-form"
            class="w-full sm:w-auto bg-[#FCD34D] hover:bg-[#FBBF24] text-slate-950 font-black py-4 px-10 rounded-2xl text-xs sm:text-sm tracking-widest uppercase transition-all duration-300 border-2 border-slate-950 shadow-[4px_4px_0px_0px_rgba(2,6,23,1)] hover:shadow-none hover:translate-x-1 hover:translate-y-1 flex items-center justify-center gap-3 group"
          >
            <span>Book Discovery Call</span>
            <ArrowRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="pt-6 border-t border-slate-300/80 max-w-2xl mx-auto flex flex-wrap items-center justify-center gap-6 text-xs text-slate-800 font-mono font-bold">
          <span class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> 7-Day Implementation
          </span>
          <span class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Zero Code Overhead
          </span>
          <span class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Native API & Webhooks
          </span>
        </div>

        <!-- Problem & Solution Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 text-left max-w-5xl mx-auto">
          <div
            class="bg-gradient-to-b from-[#FFFDF5] to-white border-2 border-slate-950 p-8 rounded-3xl shadow-[6px_6px_0px_0px_rgba(2,6,23,1)]"
          >
            <span
              class="text-[10px] font-mono font-black text-red-600 bg-red-100 border border-red-300 px-2.5 py-1 rounded-md uppercase tracking-widest inline-block mb-3"
            >
              ✖ THE OLD WAY: DISCONNECTED TOOLS
            </span>
            <h3 class="text-lg font-bold font-display text-slate-950 uppercase mb-2">
              10+ Hours Wasted on Double Data Entry
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              Copying email inquiries into spreadsheets, manually creating invoices after job completion, and sending scheduling links back and forth. Human errors happen, invoices get delayed, and team productivity suffers.
            </p>
          </div>

          <div
            class="bg-gradient-to-b from-[#F0FDFD] to-white border-2 border-slate-950 p-8 rounded-3xl shadow-[6px_6px_0px_0px_rgba(2,6,23,1)]"
          >
            <span
              class="text-[10px] font-mono font-black text-emerald-700 bg-emerald-100 border border-emerald-300 px-2.5 py-1 rounded-md uppercase tracking-widest inline-block mb-3"
            >
              ✔ THE AMBERLY WAY: AUTOPILOT AI WORKFLOW
            </span>
            <h3 class="text-lg font-bold font-display text-slate-950 uppercase mb-2">
              Unified Digital Pipeline in Seconds
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              Your website, CRM, scheduling calendars, accounting apps, and Slack channels operate as one connected system. Data moves instantly with zero manual effort and zero copy-pasting.
            </p>
          </div>
        </div>

      </div>
    </header>

    <!-- SHOW WHAT YOU INTEGRATE SECTION (Matching Navbar Margins + Actual Logos) -->
    <section class="py-20 bg-white border-b-2 border-slate-950">
      <div class="max-w-8xl mx-auto px-6 lg:px-12">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >⚡ INTEGRATIONS</span
          >
          <h2
            class="text-4xl lg:text-5xl font-black text-slate-950 uppercase tracking-tight font-display leading-tight"
          >
            Integrates With Your Tech Stack
          </h2>
          <p class="text-slate-600 text-base font-medium mt-3">
            We connect natively with the software your business relies on — no migration or tool replacement required.
          </p>
        </div>

        <!-- Integration Grid with Actual Logos -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5">
          {
            integrations.map((item) => (
              <div
                class={`bg-gradient-to-b ${item.color} border-2 border-slate-950 p-6 rounded-2xl shadow-[4px_4px_0px_0px_rgba(2,6,23,1)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between`}
              >
                <div>
                  <div class="flex items-center justify-between mb-4 gap-2">
                    <div class="w-10 h-10 rounded-xl bg-white border border-slate-950/15 flex items-center justify-center p-2 shadow-xs shrink-0">
                      <Fragment set:html={item.svgLogo} />
                    </div>
                    <span class={`text-[9px] font-mono font-black px-2 py-0.5 rounded border border-slate-950/20 ${item.badgeColor} uppercase tracking-wider shrink-0`}>
                      {item.category}
                    </span>
                  </div>

                  <h3 class="text-base font-black font-display text-slate-950 uppercase tracking-tight">
                    {item.name}
                  </h3>
                </div>

                <div class="pt-3 border-t border-slate-950/10 mt-4 flex items-center justify-between text-[10px] font-mono text-emerald-700 font-bold">
                  <span>Native Node</span>
                  <span>✔ Verified</span>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Custom API Box -->
        <div class="mt-10 p-8 rounded-3xl bg-slate-950 border-2 border-slate-950 text-white shadow-[6px_6px_0px_0px_rgba(252,211,77,1)] flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-[#FCD34D] text-slate-950 border-2 border-slate-950 flex items-center justify-center shrink-0 shadow-[2px_2px_0px_0px_rgba(255,255,255,1)]">
              <Server className="w-7 h-7" />
            </div>
            <div>
              <h4 class="text-xl font-bold font-display uppercase text-amber-400">Custom REST & Webhook Connections</h4>
              <p class="text-xs sm:text-sm text-slate-300 font-medium">Don't see your software? We build custom API nodes for any proprietary or legacy platform.</p>
            </div>
          </div>
          <a
            href="/#onboarding-form"
            class="shrink-0 bg-[#FCD34D] hover:bg-[#FBBF24] text-slate-950 font-black text-xs px-6 py-3.5 rounded-xl border-2 border-slate-950 uppercase tracking-widest transition-all shadow-[2px_2px_0px_0px_rgba(255,255,255,1)]"
          >
            Check Compatibility →
          </a>
        </div>

      </div>
    </section>

    <!-- WHAT WE AUTOMATE SECTION (Matching Navbar Margins) -->
    <section class="py-20 bg-slate-50 border-b-2 border-slate-950">
      <div class="max-w-8xl mx-auto px-6 lg:px-12">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
