---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Footer } from "@/components/Footer";
import { SERVICES, generateFAQSchema } from "@/lib/seo-data";
import {
  Layers,
  CheckCircle2,
  Database,
  Link as LinkIcon,
  Flame,
  ShieldCheck,
  ArrowRight,
  Zap,
  Clock,
  Sparkles,
  Bot,
  Mail,
  Calendar,
  FileText,
  MessageSquare,
  TrendingUp,
  Check,
  Cpu,
  Workflow,
  BarChart3,
  Lock,
  RefreshCw,
  Server,
  Terminal,
} from "lucide-react";

const service = SERVICES["ai-automation-integration"];

const faqItems = [
  {
    q: "Which business software integrations do you support?",
    a: "We support integrations across all major business platforms including HubSpot, Salesforce, Google Workspace, Outlook, Stripe, QuickBooks, Xero, Slack, Notion, Zapier, Make, ServiceM8, and ServiceTitan.",
  },
  {
    q: "Do I need to pay for external tools like Zapier?",
    a: "For simple workflows, standard Zapier or Make plans ($20-$40/mo) work great. For high-volume or enterprise pipelines, we custom-write direct API connections in code to bypass subscription limits entirely.",
  },
  {
    q: "Is my customer data and business database secure?",
    a: "Yes. All integration pipelines use secure OAuth 2.0 validation protocols and TLS/HTTPS encryption. We don't store your database on middleman servers; data moves directly between your official accounts.",
  },
  {
    q: "What happens if we switch CRMs or software tools later?",
    a: "Our workflows are built modularly. If you upgrade from Google Sheets to Salesforce or switch accounting tools, we can quickly rewire the automation nodes without needing to rebuild your entire setup.",
  },
  {
    q: "How fast can an AI workflow be deployed?",
    a: "Most custom workflows are audited, built, tested, and deployed in 7 to 14 days with zero operational downtime for your team.",
  },
];

const faqSchemaJson = generateFAQSchema(faqItems);

const integrations = [
  {
    name: "HubSpot",
    category: "CRM & Sales",
    color: "from-[#FFF7ED] to-white border-orange-300",
    badgeColor: "bg-orange-500 text-white",
    svgLogo: `<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="#FF7A59"><path d="M18.164 7.757a3.52 3.52 0 0 0-2.316-.889 3.535 3.535 0 0 0-3.522 3.536c0 .416.074.814.208 1.185L9.61 14.516a3.504 3.504 0 0 0-1.428-.302 3.536 3.536 0 1 0 3.536 3.536c0-.46-.092-.897-.253-1.296l2.846-2.846a3.54 3.54 0 0 0 1.53.351 3.535 3.535 0 0 0 3.536-3.536 3.518 3.518 0 0 0-1.211-2.666zM8.182 19.824a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6zm7.666-8.555a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z"/></svg>`,
  },
