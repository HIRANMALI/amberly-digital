  <!-- SCRIPTS: RINGG AI WIDGET DEMO TRIGGER BINDINGS -->
  <script is:inline>
    function triggerRinggDemo() {
      // 1. Try unauthenticated sign-in modal first
      var unauthBtn = document.getElementById("ringg-unauth-btn");
      if (unauthBtn) {
        unauthBtn.click();
        return;
      }
      // 2. Try auth-gated Ringg container
      var container = document.getElementById("ringg_ai_container");
      if (container) {
        var btn = container.querySelector("button") || container.querySelector("iframe");
        if (btn) {
          btn.click();
          return;
        }
      }
      // 3. Fallback smooth scroll to live sample transcript
      var sampleSection = document.getElementById("sample-call-section");
      if (sampleSection) {
        sampleSection.scrollIntoView({ behavior: "smooth" });
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      var triggerBtn = document.getElementById("trigger-voice-demo-btn");
      var talkBtn = document.getElementById("talk-ai-receptionist-btn");
      if (triggerBtn) {
        triggerBtn.addEventListener("click", triggerRinggDemo);
      }
      if (talkBtn) {
        talkBtn.addEventListener("click", triggerRinggDemo);
      }
    });
  </script>
