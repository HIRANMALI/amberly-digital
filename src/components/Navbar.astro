---
import { SERVICES } from "@/lib/seo-data";
---

<div class="h-[82px] w-full relative">
  <nav
    id="primary-navigation"
    class="bg-white border-b-2 border-slate-950 fixed top-0 left-0 right-0 z-50 w-full transition-transform duration-300 ease-in-out translate-y-0"
  >
    <div
      class="max-w-8xl mx-auto px-6 lg:px-12 w-full flex items-center justify-between min-h-20 py-4 lg:py-0"
    >
      <!-- Brand/Logo -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-3 group">
          <div
            class="w-12 h-12 bg-amber-500 rounded-none border-2 border-slate-950 flex items-center justify-center font-black text-slate-950 text-3xl pt-0.5"
          >
            A
          </div>
          <span
            class="text-2xl font-black tracking-tighter uppercase font-display text-slate-950"
          >
            Amberly <span class="text-amber-600">Digital</span>
          </span>
        </a>
      </div>

      <!-- Desktop Links (Hidden on mobile/tablet) -->
      <div class="hidden lg:flex items-center gap-8 h-20 relative">
        <a
          href="/"
          class="text-xs font-mono font-black text-slate-900 hover:text-amber-600 transition-colors uppercase tracking-widest py-2"
        >
          Home
        </a>

        <!-- Services Dropdown -->
        <div class="h-full flex items-center relative group">
          <button
            class="text-xs font-mono font-black text-slate-900 hover:text-amber-600 transition-colors uppercase tracking-widest flex items-center gap-1 py-2 cursor-pointer"
          >
            Services
            <svg
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
            >
          </button>
          <!-- Dropdown Panel (CSS Hover based) -->
          <div
            class="absolute top-[60px] left-1/2 -translate-x-1/2 hidden group-hover:block z-50 pointer-events-auto origin-top pt-2"
          >
            <div
              class="bg-slate-50 border-2 border-slate-950 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] rounded-none overflow-hidden pointer-events-auto w-[640px] p-6 grid grid-cols-2 gap-4"
            >
              {
                Object.entries(SERVICES).map(([slug, s]) => {
                  let iconSvg = `<svg class="w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></svg>`;

                  if (s.icon === "Code") {
                    iconSvg = `<svg class="w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`;
                  } else if (s.icon === "Phone") {
                    iconSvg = `<svg class="w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`;
                  } else if (s.icon === "MessageSquare") {
                    iconSvg = `<svg class="w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`;
                  } else if (s.icon === "Globe") {
                    iconSvg = `<svg class="w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`;
                  } else if (s.icon === "MapPin") {
                    iconSvg = `<svg class="w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`;
                  } else if (s.icon === "Layers") {
                    iconSvg = `<svg class="w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`;
                  }
                  return (
                    <a
                      href={`/services/${slug}`}
                      class="p-3 hover:bg-slate-200 transition-colors flex gap-3 group rounded-none"
                    >
                      <div class="w-8 h-8 bg-amber-500/10 text-amber-600 border border-slate-950/20 flex items-center justify-center shrink-0">
                        <Fragment set:html={iconSvg} />
                      </div>
                      <div class="flex flex-col gap-0.5">
                        <span class="text-xs font-black font-mono uppercase tracking-wider text-slate-900 transition-colors">
                          {s.title}
                        </span>
                        <span class="text-[10px] text-slate-550 leading-normal font-semibold">
                          {s.shortDesc}
                        </span>
                      </div>
                    </a>
                  );
                })
              }
            </div>
          </div>
        </div>

        <a
          href="/blog"
          class="text-xs font-mono font-black text-slate-900 hover:text-amber-600 transition-colors uppercase tracking-widest py-2"
        >
          Blog
        </a>

        <!-- Used AI Credits Display -->
        <div
          class="flex items-center gap-2 pl-2 pr-2.5 py-1.5 border-2 border-slate-950 bg-amber-500/10 text-slate-950 select-none ml-4 whitespace-nowrap"
        >
          <svg
            class="w-3.5 h-3.5 text-amber-600 fill-amber-600 animate-pulse shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            ><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
            ></polygon></svg
          >
          <span
            class="font-display font-black text-base text-slate-950 leading-none"
          >
            <span class="credits-counter">0</span> / 5
          </span>
        </div>

        <a
          href="/#onboarding-form"
          class="bg-slate-900 text-white px-6 py-3 font-black text-xs rounded-none hover:bg-slate-800 transition-all uppercase tracking-widest border-2 border-slate-950 shadow-[3px_3px_0px_0px_rgba(245,158,11,1)] ml-4 whitespace-nowrap flex items-center gap-2"
        >
          <span>Get Started</span>
          <svg
            class="w-4 h-4 shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
      </div>

      <!-- Mobile Hamburger Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 border-2 border-slate-950 bg-slate-100 hover:bg-amber-500 transition-colors cursor-pointer"
        aria-label="Toggle navigation menu"
      >
        <svg
          id="menu-icon"
          class="w-6 h-6 text-slate-950"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="4" x2="20" y1="12" y2="12"></line><line
            x1="4"
            x2="20"
            y1="6"
            y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
        >
        <svg
          id="close-icon"
          class="w-6 h-6 text-slate-950 hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
      </button>
    </div>
  </nav>
</div>

<!-- Mobile Drawer -->
<div
  id="mobile-drawer"
  class="hidden lg:hidden fixed inset-x-0 top-20 bg-white border-b-2 border-slate-950 z-40 p-6 flex flex-col gap-6 shadow-[0px_4px_10px_rgba(0,0,0,0.1)] max-h-[calc(100vh-80px)] overflow-y-auto"
>
  <div class="flex flex-col gap-4">
    <a
      href="/"
      class="mobile-menu-link text-sm font-black font-mono uppercase tracking-widest text-slate-900 hover:text-amber-600 transition-colors py-2 border-b border-slate-100"
    >
      Home
    </a>
    <a
      href="/blog"
      class="mobile-menu-link text-sm font-black font-mono uppercase tracking-widest text-slate-900 hover:text-amber-600 transition-colors py-2 border-b border-slate-100"
    >
      Blog
    </a>
    <!-- Mobile Services Collapse -->
    <div class="flex flex-col">
      <button
        id="mobile-services-btn"
        class="text-sm font-black font-mono uppercase tracking-widest text-slate-900 hover:text-amber-600 transition-colors py-2 border-b border-slate-100 flex items-center justify-between cursor-pointer"
      >
        <span>Services</span>
        <svg
          id="mobile-services-chevron"
          class="w-4 h-4 transition-transform duration-200"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
        >
      </button>
      <div
        id="mobile-services-content"
        class="hidden pl-4 py-2 flex flex-col gap-2 bg-slate-50 border-l-2 border-amber-500 mt-1"
      >
        {
          Object.entries(SERVICES).map(([slug, s]) => (
            <a
              href={`/services/${slug}`}
              class="mobile-menu-link text-xs font-mono font-bold uppercase py-1.5 text-slate-700 hover:text-amber-600 transition-colors"
            >
              {s.title}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Mobile Used AI Credits Display -->
  <div
    class="flex items-center gap-2.5 px-4 py-3 bg-amber-500/10 border-2 border-slate-950"
  >
    <svg
      class="w-3.5 h-3.5 text-amber-600 fill-amber-600 animate-pulse shrink-0"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      ><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg
    >
    <span
      class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-700"
      >AI Credits:</span
    >
    <span class="font-display font-black text-base text-slate-950 leading-none">
      <span class="credits-counter">0</span>/5
    </span>
  </div>

  <a
    href="/#onboarding-form"
    class="mobile-menu-link w-full bg-slate-900 text-white px-6 py-4 font-black text-xs rounded-none hover:bg-slate-800 transition-colors uppercase tracking-widest flex items-center justify-center gap-2 border-2 border-slate-950 shadow-[3px_3px_0px_0px_rgba(245,158,11,1)]"
  >
    <span>Get Started</span>
    <svg
      class="w-4 h-4 shrink-0"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
    >
  </a>
</div>

<!-- Inline script to restore credits from cache synchronously and prevent any paint flicker -->
<script is:inline>
  (function () {
    try {
      const cached = localStorage.getItem("ai_credits_used");
      if (cached !== null) {
        document.querySelectorAll(".credits-counter").forEach(function (el) {
          el.textContent = cached;
        });
      }
    } catch (e) {}
  })();
</script>

<script>
  // Mobile menu open/close toggles
  const btn = document.getElementById("mobile-menu-btn");
  const drawer = document.getElementById("mobile-drawer");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");
  if (btn && drawer && menuIcon && closeIcon) {
    btn.addEventListener("click", () => {
      const isOpen = !drawer.classList.contains("hidden");
      if (isOpen) {
        drawer.classList.add("hidden");
        menuIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      } else {
        drawer.classList.remove("hidden");
        menuIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
      }
    });
  }

  // Close mobile menu on clicking any drawer link
  document.querySelectorAll(".mobile-menu-link").forEach((link) => {
    link.addEventListener("click", () => {
      if (drawer && menuIcon && closeIcon) {
        drawer.classList.add("hidden");
        menuIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      }
    });
  });

  // Services accordion in mobile drawer
  const servicesBtn = document.getElementById("mobile-services-btn");
  const servicesContent = document.getElementById("mobile-services-content");
  const servicesChevron = document.getElementById("mobile-services-chevron");
  if (servicesBtn && servicesContent && servicesChevron) {
    servicesBtn.addEventListener("click", () => {
      const isHidden = servicesContent.classList.contains("hidden");
      if (isHidden) {
        servicesContent.classList.remove("hidden");
        servicesChevron.classList.add("rotate-180");
      } else {
        servicesContent.classList.add("hidden");
        servicesChevron.classList.remove("rotate-180");
      }
    });
  }

  // Scroll visibility management (hide on scroll down, show on scroll up)
  let lastScrollY = window.scrollY;
  const nav = document.getElementById("primary-navigation");
  window.addEventListener(
    "scroll",
    () => {
      // Keep visible if mobile drawer is open
      if (drawer && !drawer.classList.contains("hidden")) return;
      const currentScrollY = window.scrollY;
      if (currentScrollY <= 80) {
        nav?.classList.remove("-translate-y-full");
        nav?.classList.add("translate-y-0");
      } else if (currentScrollY > lastScrollY) {
        nav?.classList.remove("translate-y-0");
        nav?.classList.add("-translate-y-full");
      } else {
        nav?.classList.remove("-translate-y-full");
        nav?.classList.add("translate-y-0");
      }
      lastScrollY = currentScrollY;
    },
    { passive: true },
  );

  // Sync AI credits with endpoint and cache in localStorage
  const updateCredits = async () => {
    try {
      const res = await fetch("/api/verify-domain");
      if (res.ok) {
        const data = await res.json();
        if (data && typeof data.used === "number") {
          localStorage.setItem("ai_credits_used", String(data.used));
          document.querySelectorAll(".credits-counter").forEach((el) => {
            el.textContent = String(data.used);
          });
        }
      }
    } catch (err) {
      console.warn("Failed to fetch used credits:", err);
    }
  };

  // Load cached value immediately on initial load / navigation to prevent flicker
  const cached = localStorage.getItem("ai_credits_used");
  if (cached !== null) {
    document.querySelectorAll(".credits-counter").forEach((el) => {
      el.textContent = cached;
    });
  } else {
    // Only run initial fetch if no cache is stored
    updateCredits();
  }

  // Listen to local scanner state updates (before and after scans)
  window.addEventListener("creditsUpdated", updateCredits);
</script>
