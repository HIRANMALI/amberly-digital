---
/**
 * RinggWidget.astro
 * ─────────────────────────────────────────────────────────────────
 * Auth-gated Ringg AI voice & chat widget.
 *
 * How it works:
 *   1. On DOMContentLoaded, fetches GET /users/me with credentials.
 *   2. Authenticated  → loads the real Ringg SDK; user's name is passed
 *      into callee_name so the AI greets them personally.
 *   3. Unauthenticated / server error → shows a look-alike floating
 *      phone button. Clicking it opens a branded sign-in modal that
 *      redirects to Google OAuth, returning to the current page.
 *
 * Props:
 *   agentId     – Ringg agent UUID            (PUBLIC_RINGG_AGENT_ID)
 *   apiKey      – Ringg bearer token          (PUBLIC_RINGG_API_KEY)
 *   apiUrl      – Production backend base URL (PUBLIC_API_URL)
 *   localApiUrl – Local dev backend base URL  (PUBLIC_LOCAL_API_URL, optional)
 *
 * Usage (in BaseLayout.astro):
 *   import RinggWidget from '../components/RinggWidget.astro';
 *   {showRinggWidget && <RinggWidget agentId={...} apiKey={...} apiUrl={...} localApiUrl={...} />}
 */

interface Props {
  agentId: string;
  apiKey: string;
  apiUrl: string;
  localApiUrl?: string;
}

const { agentId, apiKey, apiUrl, localApiUrl } = Astro.props;

/** CDN version to pin — bump this string to upgrade the Ringg SDK */
const CDN_VERSION = "2.0.0-beta.15";
---

<!-- ── Scoped global styles for resizing the widget panel inside parent page ──── -->
<style is:global>
  /* Make the active expanded Ringg widget panel significantly bigger (e.g. 450x660 instead of 380x600)
     to avoid layout cramping, squished text, and negative white space. */
  #ringg_ai_container.ringg-widget-expanded,
  #ringg_ai_container.ringg-widget-expanded iframe,
  iframe.ringg-widget-expanded {
    width: 450px !important;
    height: 660px !important;
    max-width: 95vw !important;
    max-height: 95vh !important;
    transition: width 0.2s ease, height 0.2s ease !important;
  }
</style>

<!-- ── Unauthenticated Floating Button (responsive: all 6 Tailwind breakpoints) ──
     Identical responsive sizes and positions as calculated dynamically in JS for
     the real widget launcher to ensure a seamless transition on auth. -->
<div id="ringg-unauth-btn" class="fixed bottom-6 right-6 z-50 hidden">
  <button
    id="ringg-unauth-trigger"
    aria-label="Talk to our AI assistant"
    class="
      w-[60px] h-[60px]
      sm:w-[62px] sm:h-[62px]
      md:w-[64px] md:h-[64px]
      lg:w-[66px] lg:h-[66px]
      xl:w-[70px] xl:h-[70px]
      2xl:w-[76px] 2xl:h-[76px]
      bg-[#020617]
      rounded-[18px] sm:rounded-[20px] md:rounded-[20px] lg:rounded-[22px] xl:rounded-[24px] 2xl:rounded-[26px]
      flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition-transform cursor-pointer border-2 border-[#020617]
    "
  >
    <svg
      class="
        w-[26px] h-[26px]
        sm:w-[27px] sm:h-[27px]
        md:w-[28px] md:h-[28px]
        lg:w-[29px] lg:h-[29px]
        xl:w-[31px] xl:h-[31px]
        2xl:w-[34px] 2xl:h-[34px]
        text-white
      "
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
    </svg>
  </button>
</div>

<!-- ── Sign-in Modal ──────────────────────────────────────────────── -->
<div
  id="ringg-auth-modal"
  class="fixed inset-0 z-[200] flex items-end sm:items-center justify-center bg-slate-950/60 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ringg-modal-title"
>
  <!-- Card: bottom sheet on mobile, compact centred card on sm+ -->
  <div
    class="w-full bg-white border-2 border-slate-950 shadow-xl flex flex-col items-center text-center relative
              rounded-t-2xl px-6 pt-8 pb-7
              sm:rounded-2xl sm:w-auto sm:max-w-sm sm:mx-4 sm:px-8 sm:pt-9 sm:pb-8
              md:max-w-md md:px-10
              lg:max-w-md
              xl:max-w-lg xl:px-12 xl:pt-10 xl:pb-9
              2xl:max-w-lg"
  >
    <!-- Close button -->
    <button
      id="ringg-auth-close"
      aria-label="Close sign-in dialog"
      class="absolute top-3 right-3 sm:top-4 sm:right-4
             text-slate-400 hover:text-slate-900 transition-colors cursor-pointer
             w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Phone icon — fixed size across all non-mobile breakpoints -->
    <div
      class="w-12 h-12 sm:w-14 sm:h-14 bg-slate-100 border-2 border-slate-950 rounded-full flex items-center justify-center mb-4"
    >
      <svg
        class="w-6 h-6 sm:w-7 sm:h-7"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
    </div>

    <!-- Heading -->
    <h2
      id="ringg-modal-title"
      class="font-display font-black uppercase tracking-tight text-slate-950 text-xl sm:text-2xl mb-2"
    >
      Sign In Required
    </h2>

    <!-- Description -->
    <p
      class="text-slate-500 leading-relaxed font-semibold text-sm mb-5 sm:mb-6 max-w-xs"
    >
      Please sign up or log in to start a call or chat with our 24/7 AI
      receptionist.
    </p>

    <!-- Google Sign-in Button -->
    <a
      id="ringg-auth-signin"
      href="/ai-studio"
      class="w-full bg-slate-900 hover:bg-slate-800 text-white font-black uppercase tracking-wider
             rounded-xl flex items-center justify-center gap-2
             transition-all shadow-md hover:scale-[1.01] active:scale-95 cursor-pointer
             py-3 text-[10px] sm:text-xs"
    >
      <svg viewBox="0 0 24 24" class="w-5 h-5 shrink-0" aria-hidden="true">
        <path
          d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          fill="#4285F4"></path>
        <path
          d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          fill="#34A853"></path>
        <path
          d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
          fill="#FBBC05"></path>
        <path
          d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
          fill="#EA4335"></path>
      </svg>
      Sign in to Talk
    </a>
  </div>
</div>

<!-- ── Widget Logic ───────────────────────────────────────────────── -->
<script
  is:inline
  define:vars={{ agentId, apiKey, apiUrl, localApiUrl, CDN_VERSION }}
>
  (function () {
    "use strict";

    var widgetLoaded = false;

    // ─ Helpers ──────────────────────────────────────────────────────

    /** Returns local or production API base URL based on hostname */
    function getApiUrl() {
      var isLocal =
        window.location.hostname === "localhost" ||
        window.location.hostname === "127.0.0.1";
      return isLocal && localApiUrl && localApiUrl !== "undefined"
        ? localApiUrl
        : apiUrl;
    }

    /** Injects the Ringg CDN stylesheet + ES module script, then fires cb */
    function loadCdn(version, cb) {
      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.type = "text/css";
      link.href =
        "https://cdn.jsdelivr.net/npm/@desivocal/agents-cdn@" +
        version +
        "/dist/style.css";

      var script = document.createElement("script");
      script.type = "text/javascript";
      script.src =
        "https://cdn.jsdelivr.net/npm/@desivocal/agents-cdn@" +
        version +
        "/dist/dv-agent.es.js";

      if (script.readyState) {
        script.onreadystatechange = function () {
          if (
            script.readyState === "loaded" ||
            script.readyState === "complete"
          ) {
            script.onreadystatechange = null;
            cb();
          }
        };
      } else {
        script.onload = cb;
      }

      document.head.appendChild(link);
      document.head.appendChild(script);
    }

    // ─ Widget ────────────────────────────────────────────────────────

    /** Loads and mounts the real Ringg AI widget (only when authenticated) */
    function mountWidget(userName) {
      if (widgetLoaded) return;
      widgetLoaded = true;

      // Calculate sizes dynamically on load to match the unauth buttons across all breakpoints
      var w = window.innerWidth;
      var launcherSize = 60;
      var iconSize = 26;
      var bRadius = 18;

      if (w >= 1536) {
        launcherSize = 76; iconSize = 34; bRadius = 26;
      } else if (w >= 1280) {
        launcherSize = 70; iconSize = 31; bRadius = 24;
      } else if (w >= 1024) {
        launcherSize = 66; iconSize = 29; bRadius = 22;
      } else if (w >= 768) {
        launcherSize = 64; iconSize = 28; bRadius = 20;
      } else if (w >= 640) {
        launcherSize = 62; iconSize = 27; bRadius = 20;
      } else {
        launcherSize = 60; iconSize = 26; bRadius = 18;
      }

      loadCdn(CDN_VERSION, function () {
        if (typeof loadAgent !== "function") return;

        loadAgent({
          agentId: agentId,
          authorization: "Bearer " + apiKey,
          variables: {
            callee_name: userName || "there",
            intent: "INTENT",
          },
          defaultTab: "audio",
          title: "Amberly AI",
          logoUrl: "/amberly-digital-logo-icon-round.svg?v=2",
          theme: {
            primaryColor: "#020617",
            primaryTextColor: "#ffffff",
            backgroundColor: "#ffffff",
            surfaceColor: "#f8fafc",
            textColor: "#0f172a",
            mutedTextColor: "#475569",
            borderColor: "#e2e8f0",
            borderRadius: "16px",
            buttonStyle: "pill",
          },
          buttons: {
            modalTrigger: {
              styles: {
                backgroundColor: "#020617",
                color: "#ffffff",
                border: "2px solid #020617",
                width: launcherSize + "px",
                height: launcherSize + "px",
                borderRadius: bRadius + "px"
              },
              icon: { size: iconSize },
            },
          },
        });
      });
    }

    // ─ Unauthenticated UI ────────────────────────────────────────────

    /** Attach an event listener exactly once, tracked via data-bound */
    function bindOnce(el, event, handler) {
      if (!el || el.dataset.bound) return;
      el.dataset.bound = "1";
      el.addEventListener(event, handler);
    }

    function showSignInPrompt(activeApiUrl) {
      var btn = document.getElementById("ringg-unauth-btn");
      var modal = document.getElementById("ringg-auth-modal");
      var closeBtn = document.getElementById("ringg-auth-close");
      var signinBtn = document.getElementById("ringg-auth-signin");
      var trigger = document.getElementById("ringg-unauth-trigger");

      if (btn) btn.classList.remove("hidden");

      bindOnce(trigger, "click", function () {
        if (modal) modal.classList.remove("hidden");
      });
      bindOnce(closeBtn, "click", function () {
        if (modal) modal.classList.add("hidden");
      });
      bindOnce(modal, "click", function (e) {
        if (e.target === modal) modal.classList.add("hidden");
      });

      // Point the sign-in link at the OAuth endpoint with the current page as redirect_to
      if (signinBtn && activeApiUrl) {
        var redirectUri = encodeURIComponent(
          window.location.origin + window.location.pathname,
        );
        signinBtn.setAttribute(
          "href",
          activeApiUrl + "/auth/google?redirect_to=" + redirectUri,
        );
      }
    }

    function hideSignInPrompt() {
      var btn = document.getElementById("ringg-unauth-btn");
      if (btn) btn.classList.add("hidden");
    }

    // ─ Auth Check ────────────────────────────────────────────────────

    function checkAuth() {
      // 1. Try checking local storage first for fast response
      var localProfileRaw = localStorage.getItem("user_profile");
      if (localProfileRaw) {
        try {
          var localProfile = JSON.parse(localProfileRaw);
          if (localProfile && localProfile.name) {
            hideSignInPrompt();
            mountWidget(localProfile.name);
            return; // Fast path: authenticated!
          }
        } catch (e) {}
      }

      // 2. Fallback: ask the backend if not cached locally
      var activeApiUrl = getApiUrl();
      if (!activeApiUrl) {
        showSignInPrompt(null);
        return;
      }

      fetch(activeApiUrl + "/users/me", { credentials: "include" })
        .then(function (res) {
          if (res.ok) return res.json();
          // 401 or any non-OK → logged out; clear stale local cache
          localStorage.removeItem("user_profile");
          localStorage.removeItem("user_tasks");
          return null;
        })
        .then(function (data) {
          if (!data) {
            showSignInPrompt(activeApiUrl);
            return;
          }

          // Normalise response
          var p = data.data || data;
          var name =
            p.name ||
            p.full_name ||
            (p.user && (p.user.name || p.user.full_name)) ||
            (p.email && p.email.split("@")[0]) ||
            (p.user && p.user.email && p.user.email.split("@")[0]) ||
            "there";
          var avatar =
            p.avatar_url ||
            p.picture ||
            (p.user && (p.user.avatar_url || p.user.picture)) ||
            null;

          localStorage.setItem("user_profile", JSON.stringify({ name: name, avatar: avatar }));

          hideSignInPrompt();
          mountWidget(name);
        })
        .catch(function () {
          localStorage.removeItem("user_profile");
          localStorage.removeItem("user_tasks");
          showSignInPrompt(activeApiUrl);
        });
    }

    // ─ Setup expanded observer ───────────────────────────────────────
    // Periodically monitor the DOM for the Ringg container. If the inner
    // iframe has expanded, we append a CSS class to scale the widget size.
    setInterval(function() {
      var container = document.getElementById("ringg_ai_container");
      if (!container) return;

      var iframe = container.querySelector("iframe");
      if (!iframe) return;

      var rect = iframe.getBoundingClientRect();
      var isExpanded = rect.height > 120 && window.getComputedStyle(iframe).display !== "none";

      if (isExpanded) {
        container.classList.add("ringg-widget-expanded");
        iframe.classList.add("ringg-widget-expanded");
      } else {
        container.classList.remove("ringg-widget-expanded");
        iframe.classList.remove("ringg-widget-expanded");
      }
    }, 250);

    // ─ Boot ──────────────────────────────────────────────────────────
    document.addEventListener("DOMContentLoaded", checkAuth);
  })();
</script>
