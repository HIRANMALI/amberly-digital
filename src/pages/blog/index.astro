---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Footer } from "@/components/Footer";
import { BLOG_POSTS } from "@/lib/blog-data";

const posts = Object.values(BLOG_POSTS);

const blogListSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "The Tradie Blueprint",
  description:
    "Actionable local SEO, Answer Engine Optimization (AEO), and automation advice for Australian trade businesses.",
  publisher: {
    "@type": "LocalBusiness",
    name: "Amberly Digital",
    url: "https://amberlydigital.com",
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    description: post.excerpt,
    datePublished: post.date,
    author: { "@type": "Organization", name: post.author },
    url: `https://amberlydigital.com/blog/${post.slug}`,
  })),
};
---

<BaseLayout
  title="The Tradie Blueprint | Amberly Digital Blog"
  description="Actionable local SEO, Answer Engine Optimization (AEO), and automation advice for Australian trade businesses. Zero fluff. Just bookings."

  ogTitle="The Tradie Blueprint | Amberly Digital Blog"
  ogDescription="Actionable local SEO, Answer Engine Optimization (AEO), and automation advice for Australian trade businesses."
  ogUrl="https://amberlydigital.com/blog"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(blogListSchema)}
  />

  <Navbar />

  <!-- HERO SECTION -->
  <header class="border-b-2 border-slate-950 bg-white py-16">
    <div class="max-w-8xl mx-auto px-6 lg:px-12">
      <div class="max-w-3xl">
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono font-black text-slate-900 border-2 border-slate-950 bg-amber-500 shadow-[2px_2px_0px_rgba(0,0,0,1)] uppercase tracking-wider mb-6"
        >
          <svg
            class="w-3.5 h-3.5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path
              d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg
          >
          <span>THE TRADIE BLUEPRINT</span>
        </span>
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-black font-display leading-none mb-6 text-slate-950 uppercase tracking-tight"
        >
          Growth Blueprints for <span class="text-amber-500"
            >Aussie Tradies</span
          >.
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed font-medium">
          No marketing jargon. No vanity metrics. Just clear, data-backed guides
          on Google Maps rankings, AEO (AI search recommendations), and phone
          automation systems designed to keep your phone ringing.
        </p>
      </div>
    </div>
  </header>

  <!-- BLOGS GRID -->
  <main class="py-16 bg-slate-50 border-b-2 border-slate-950 flex-1">
    <div class="max-w-8xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          posts.map((post) => {
            let categoryColor = "bg-slate-100 text-slate-900 border-slate-900";
            if (post.category === "SEO")
              categoryColor = "bg-amber-100 text-amber-900 border-amber-500";
            else if (post.category === "AEO")
              categoryColor = "bg-purple-100 text-purple-900 border-purple-500";
            else if (post.category === "Automation")
              categoryColor =
                "bg-emerald-100 text-emerald-900 border-emerald-500";
            else if (post.category === "Lead Gen")
              categoryColor = "bg-blue-100 text-blue-900 border-blue-500";
            else if (post.category === "Reviews")
              categoryColor = "bg-rose-100 text-rose-900 border-rose-500";

            return (
              <a
                href={`/blog/${post.slug}`}
                class="group bg-white border-2 border-slate-950 p-6 flex flex-col justify-between shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[6px_6px_0px_0px_rgba(245,158,11,1)] hover:-translate-y-0.5 transition-all duration-300"
              >
                <article class="flex flex-col justify-between h-full w-full">
                  <div>
                    <div class="flex items-center gap-3 mb-4">
                      <span
                        class={`text-[10px] font-mono font-black px-2.5 py-0.5 border ${categoryColor} uppercase tracking-wider`}
                      >
                        {post.category}
                      </span>
                      <div class="flex items-center gap-1.5 text-xs text-slate-500 font-mono">
                        <svg
                          class="w-3.5 h-3.5"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <>
                            <rect
                              x="3"
                              y="4"
                              width="18"
                              height="18"
                              rx="2"
                              ry="2"
                            />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                          </>
                        </svg>
                        <time datetime={post.date}>
                          {new Date(post.date).toLocaleDateString("en-AU", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                          })}
                        </time>
                      </div>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-black font-display text-slate-950 uppercase tracking-tight leading-tight mb-3 group-hover:text-amber-600 transition-colors">
                      {post.title}
                    </h2>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6 font-medium">
                      {post.excerpt}
                    </p>
                  </div>
                  <div class="flex items-center justify-between pt-4 border-t border-slate-100 w-full">
                    <span class="flex items-center gap-1.5 text-xs text-slate-500 font-mono">
                      <svg
                        class="w-3.5 h-3.5"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <>
                          <circle cx="12" cy="12" r="10" />
                          <polyline points="12 6 12 12 16 14" />
                        </>
                      </svg>
                      <span>{post.readTime}</span>
                    </span>
                    <span class="text-xs font-mono font-black text-slate-900 group-hover:text-amber-600 flex items-center gap-1 transition-colors uppercase tracking-widest">
                      <span>Read →</span>
                    </span>
                  </div>
                </article>
              </a>
            );
          })
        }
      </div>
    </div>
  </main>

  <!-- CALL TO ACTION -->
  <section class="py-20 bg-slate-950 text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span
        class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest block mb-4"
        >⚡ GET IN THE MAP PACK</span
      >
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-display font-black uppercase tracking-tight mb-6"
      >
        Are Local Customers Actually Finding You?
      </h2>
      <p
        class="text-slate-400 text-base max-w-2xl mx-auto leading-relaxed mb-10"
      >
        Google Maps and AI engines are making recommendations right now in your
        service suburbs. Find out where your business stands in 60 seconds.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/#onboarding-form"
          class="w-full sm:w-auto bg-amber-500 hover:bg-white hover:text-slate-950 text-slate-950 font-black py-4 px-8 text-xs tracking-widest uppercase transition-all border-2 border-slate-950 shadow-[4px_4px_0px_0px_rgba(255,255,255,0.1)] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] text-center"
        >
          Book Free Visibility Audit
        </a>
        <a
          href="/tools#visibility-scan"
          class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white font-extrabold py-4 px-8 text-xs tracking-widest uppercase transition-all border-2 border-slate-700 text-center"
        >
          Check Suburb Visibility
        </a>
      </div>
    </div>
  </section>

  <Footer client:visible />
</BaseLayout>
