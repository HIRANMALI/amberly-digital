                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >Stripe integration & access control</span
                    >
                  </li>
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#F9A8D4] flex items-center justify-center shrink-0"
                    >
                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >AWS / Cloudflare enterprise deployment</span
                    >
                  </li>
                </ul>
                <a
                  href="#saas-development"
                  class="inline-flex items-center gap-2.5 bg-[#F9A8D4] hover:bg-[#F472B6] text-black font-bold px-8 py-3.5 rounded-full transition-all hover:scale-105 origin-left"
                >
                  Explore More
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"
                    ><path d="M8 5v14l11-7z"></path></svg
