---
// PERF_OPT: Enabled static prerendering to drastically improve FCP and LCP. Remove if SSR is needed.
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Image } from "astro:assets";
import aiReceptionistImg from "../../public/images/AI-Receptionist-3.png";
import { Footer } from "@/components/Footer";
import { AreaPartnerBooking } from "@/components/AreaPartnerBooking";
import { generateFAQSchema } from "@/lib/seo-data";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Amberly Digital",
  image: "https://amberlydigital.com/og-image.png",
  "@id": "https://amberlydigital.com/#localbusiness",
  url: "https://amberlydigital.com",
  telephone: "1300 AMBERLY",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Level 3, 100 George Street",
    addressLocality: "Sydney",
    addressRegion: "NSW",
    postalCode: "2000",
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -33.8688,
    longitude: 151.2093,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "00:00",
    closes: "23:59",
  },
  sameAs: [
    "https://www.facebook.com/amberlydigital",
    "https://www.linkedin.com/company/amberlydigital",
  ],
};

const faqItems = [
  {
    q: "Will AI replace my office staff?",
    a: "No. AI tools are designed to handle repetitive tasks like answering common questions, booking jobs, and collecting customer information, allowing your team to focus on higher-value work.",
  },
  {
    q: "What can an AI Receptionist actually do?",
    a: "An AI Receptionist can answer calls, qualify leads, collect job details, schedule appointments, and respond to enquiries 24/7â€”even when you're on-site or after business hours.",
  },
  {
    q: "Can AI help me respond to leads faster?",
    a: "Yes. AI can instantly reply to missed calls, web enquiries, and form submissions, helping you contact potential customers before they move on to a competitor.",
  },
  {
    q: "Is AI difficult to use?",
    a: "Not at all. We set everything up for you and integrate it into your existing workflow, so you can start using it without learning complicated software.",
  },
  {
    q: "How much time can AI save my business?",
    a: "Many businesses spend hours each week answering calls, chasing leads, and handling admin tasks. AI automates much of this work, helping you focus on core operations and growing your business.",
  },
];

const faqSchemaJson = generateFAQSchema(faqItems);
---

<BaseLayout>
  <!-- Schema.org LocalBusiness JSON-LD Dynamic Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaJson)} />

  <Navbar />
  <!-- LIVE ACTIVITY BANNER -->
  <div
    class="bg-amber-500 border-b-2 border-slate-950 py-2.5 px-4 text-center text-slate-950 text-xs font-mono font-black uppercase tracking-widest flex items-center justify-center gap-2 flex-wrap"
  >
    <svg
      class="w-4 h-4 text-slate-950 fill-current animate-pulse"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      ><path
        d="M17.66 11.2C17.43 10.9 17.15 10.64 16.89 10.38C16.22 9.78 15.46 9.35 14.82 8.72C13.33 7.26 13 4.85 13.95 3C13 3.23 12.17 3.75 11.46 4.32C8.87 6.4 7.85 10.07 9.07 13.22C9.11 13.32 9.15 13.42 9.15 13.55C9.15 13.77 9 13.97 8.8 14.05C8.57 14.15 8.33 14.09 8.14 13.93C8.08 13.88 8.04 13.83 8 13.76C6.87 12.33 6.69 10.28 7.45 8.64C5.78 10 4.87 12.3 5 14.47C5.06 14.97 5.12 15.47 5.29 15.97C5.43 16.57 5.7 17.17 6 17.7C7.08 19.43 8.95 20.67 10.96 20.92C13.1 21.19 15.39 20.8 17.03 19.32C18.86 17.66 19.5 15 18.56 12.72L18.43 12.46C18.22 12 17.66 11.2 17.66 11.2Z"
      ></path></svg
    >
    <span
      >Live Tools Available Now â€” No Sign-Up Required. Test Your AI &
      Automation Readiness in 10 Seconds.</span
    >
    <!-- <a
      href="/ai-studio"
      class="ml-2 underline underline-offset-2 hover:text-slate-800 transition-colors"
      >Try Free â†’</a
    > -->
  </div>

  <!-- CORE HERO SECTION - THE GEOMETRIC BALANCE HERO MATRIX -->
  <header
    class="border-b-2 border-slate-950 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-50 via-slate-300 to-slate-500"
    id="agency-hero"
  >
    <div class="max-w-8xl mx-auto px-6 lg:px-12">
      <div
        class="flex flex-col items-center justify-center text-center min-h-[580px] pt-4 lg:pt-6 pb-12 lg:pb-16 gap-8 max-w-5xl mx-auto"
      >
        <!-- Hero Core Message (Centered) -->
        <div class="flex flex-col justify-center relative py-6 w-full">
          <h1
            class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black font-display leading-none mb-6 text-slate-950 uppercase tracking-tight"
          >
            Experience Our <br class="hidden sm:block" /><span
              class="text-amber-500">AI Capabilities.</span
            >
          </h1>
          <p
            class="text-base lg:text-xl text-slate-600 leading-relaxed mb-10 font-medium max-w-3xl mx-auto"
          >
            Explore real AI tools and integrations, from image generation to
            video creation with keyframes and many more.
          </p>

          <!-- Models Grid in Hero -->
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 text-left w-full mt-4"
          >
            <a
              href="/ai-studio?mode=i2i"
              class="bg-[#5D3F33] p-5 rounded-[2rem] flex flex-col transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-900/30 group text-left relative"
            >
              <div class="px-1 mt-2 flex items-center justify-between gap-4">
                <div>
                  <div
                    class="w-10 h-10 rounded-lg bg-gradient-to-tr from-pink-500 to-amber-300 flex items-center justify-center mb-4 shadow-lg shadow-pink-500/20 text-white"
                  >
                    <svg
                      class="w-5 h-5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><rect width="18" height="18" x="3" y="3" rx="2" ry="2"
                      ></rect><circle cx="9" cy="9" r="2"></circle><path
                        d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"
                      ></path></svg
                    >
                  </div>
                  <h3 class="text-xl font-bold text-white tracking-tight mb-1">
                    AI Image Generation
                  </h3>
                  <p class="text-[13px] text-white/70 font-medium">
                    Create stunning AI images instantly.
                  </p>
                </div>
                <div
                  class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/50 group-hover:bg-white group-hover:text-slate-950 transition-colors shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </div>
              </div>
            </a>


            <a
              href="/ai-studio?mode=t2v"
              class="bg-[#284252] p-5 rounded-[2rem] flex flex-col transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-cyan-900/30 group text-left relative"
            >
              <div class="px-1 mt-2 flex items-center justify-between gap-4">
                <div>
                  <div
                    class="w-10 h-10 rounded-lg bg-gradient-to-tr from-cyan-400 to-blue-500 flex items-center justify-center mb-4 shadow-lg shadow-blue-500/20 text-white"
                  >
                    <svg
                      class="w-5 h-5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
                    >
                  </div>
                  <h3 class="text-xl font-bold text-white tracking-tight mb-1">
                    Text-to-Video
                  </h3>
                  <p class="text-[13px] text-white/70 font-medium">
                    Turn text into cinematic video.
                  </p>
                </div>
                <div
                  class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/50 group-hover:bg-white group-hover:text-slate-950 transition-colors shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </div>
              </div>
            </a>

            <a
              href="/ai-studio?mode=i2v"
              class="bg-[#3E2C4A] p-5 rounded-[2rem] flex flex-col transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-purple-900/30 group text-left relative"
            >
              <div class="px-1 mt-2 flex items-center justify-between gap-4">
                <div>
                  <div
                    class="w-10 h-10 rounded-lg bg-gradient-to-tr from-purple-500 to-indigo-400 flex items-center justify-center mb-4 shadow-lg shadow-purple-500/20 text-white"
                  >
                    <svg
                      class="w-5 h-5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M2 12h4l2-9 4 18 2-9h8"></path></svg
                    >
                  </div>
                  <h3 class="text-xl font-bold text-white tracking-tight mb-1">
                    Image-to-Video
                  </h3>
                  <p class="text-[13px] text-white/70 font-medium">
                    Animate still images with keyframes.
                  </p>
                </div>
                <div
                  class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/50 group-hover:bg-white group-hover:text-slate-950 transition-colors shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- SERVICES SHOWCASE SECTION -->
  <section class="py-24 bg-white border-b-2 border-slate-950 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div
        class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6"
      >
        <div>
          <h2
            class="text-4xl lg:text-5xl font-black text-slate-950 uppercase tracking-tight font-display mb-4 leading-tight"
          >
            Our Capabilites
          </h2>
          <p class="text-slate-600 text-lg">
            Swipe or use arrows to explore how we can accelerate your business.
          </p>
        </div>
      </div>

      <!-- Slider Wrapper with absolute buttons -->
      <div class="relative group">
        <!-- Slider Navigation Buttons (Absolute) -->
        <button
          id="slider-prev"
          class="absolute -left-12 lg:-left-16 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-slate-950 flex items-center justify-center text-white hover:bg-slate-800 transition-all shadow-lg hidden md:flex"
          aria-label="Previous slide"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
          >
        </button>

        <button
          id="slider-next"
          class="absolute -right-12 lg:-right-16 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-slate-950 flex items-center justify-center text-white hover:bg-slate-800 transition-all shadow-lg hidden md:flex"
          aria-label="Next slide"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
          >
        </button>

        <!-- Slider Container -->
        <div
          id="services-slider-container"
          class="services-slider flex overflow-x-auto snap-x snap-mandatory gap-12 w-full"
          style="scrollbar-width: none; -ms-overflow-style: none;"
        >
          <style>
            .services-slider::-webkit-scrollbar {
              display: none;
            }
          </style>

          <!-- Slide 1: AI Development -->
          <div class="w-full shrink-0 snap-start">
            <div
              class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
            >
              <div class="order-2 lg:order-1">
                <h3
                  class="text-5xl lg:text-6xl font-black text-slate-950 uppercase tracking-tight mb-4 font-display leading-tight"
                >
                  AI Development
                </h3>
                <p class="text-teal-600 font-medium text-lg lg:text-xl mb-8">
                  Custom AI Agents, RAG systems, and tailored LLM integrations
                  for your business workflows.
                </p>
                <ul class="space-y-4 mb-10">
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#A4E8D7] flex items-center justify-center shrink-0"
                    >
                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >Custom LLM fine-tuning & prompt engineering</span
                    >
                  </li>
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#A4E8D7] flex items-center justify-center shrink-0"
                    >
                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >RAG architecture with vector databases</span
                    >
                  </li>
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#A4E8D7] flex items-center justify-center shrink-0"
                    >
                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >Secure API development & deployment</span
                    >
                  </li>
                </ul>
                <a
                  href="#ai-development"
                  class="inline-flex items-center gap-2.5 bg-[#A4E8D7] hover:bg-[#8CD8C5] text-black font-bold px-8 py-3.5 rounded-full transition-all hover:scale-105 origin-left"
                >
                  Explore More
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"
                    ><path d="M8 5v14l11-7z"></path></svg
                  >
                </a>
              </div>
              <div class="order-1 lg:order-2">
                <div
                  class="rounded-xl overflow-hidden shadow-2xl ring-1 ring-slate-950/10 bg-slate-100"
                >
                  <img
                    src="/images/ai-dev.png"
                    alt="AI Development Workflow UI"
                    class="w-full h-auto aspect-[16/10] object-cover"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 2: MVP Development -->
          <div class="w-full shrink-0 snap-start">
            <div
              class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
            >
              <div class="order-2 lg:order-1">
                <h3
                  class="text-5xl lg:text-6xl font-black text-slate-950 uppercase tracking-tight mb-4 font-display leading-tight"
                >
                  Startup MVP Development
                </h3>
                <p class="text-cyan-600 font-medium text-lg lg:text-xl mb-8">
                  Prototyping and core-feature development to validate your
                  startup idea.
                </p>
                <ul class="space-y-4 mb-10">
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#87E6F9] flex items-center justify-center shrink-0"
                    >
                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >Rapid agile development sprints</span
                    >
                  </li>
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#87E6F9] flex items-center justify-center shrink-0"
                    >
                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >Core feature architecture & prioritization</span
                    >
                  </li>
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#87E6F9] flex items-center justify-center shrink-0"
                    >
                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >Responsive, conversion-focused UI</span
                    >
                  </li>
                </ul>
                <a
                  href="#mvp-development"
                  class="inline-flex items-center gap-2.5 bg-[#87E6F9] hover:bg-[#6AD2E6] text-black font-bold px-8 py-3.5 rounded-full transition-all hover:scale-105 origin-left"
                >
                  Explore More
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"
                    ><path d="M8 5v14l11-7z"></path></svg
                  >
                </a>
              </div>
              <div class="order-1 lg:order-2">
                <div
                  class="rounded-xl overflow-hidden shadow-2xl ring-1 ring-slate-950/10 bg-slate-100"
                >
                  <img
                    src="/images/mvp-dev.png"
                    alt="MVP Development Kanban UI"
                    class="w-full h-auto aspect-[16/10] object-cover"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 3: SaaS Development -->
          <div class="w-full shrink-0 snap-start">
            <div
              class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
            >
              <div class="order-2 lg:order-1">
                <h3
                  class="text-5xl lg:text-6xl font-black text-slate-950 uppercase tracking-tight mb-4 font-display leading-tight"
                >
                  SaaS Development
                </h3>
                <p class="text-pink-600 font-medium text-lg lg:text-xl mb-8">
                  Scalable, multi-tenant web applications and complex software
                  platforms.
                </p>
                <ul class="space-y-4 mb-10">
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#F9A8D4] flex items-center justify-center shrink-0"
                    >
                      <svg
                        class="w-3 h-3 text-black"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 13l4 4L19 7"></path></svg
                      >
                    </div>
                    <span class="text-slate-700 font-medium text-base"
                      >React / Next.js / Node.js full-stack</span
                    >
                  </li>
                  <li class="flex items-center gap-3">
                    <div
                      class="w-5 h-5 rounded-full bg-[#F9A8D4] flex items-center justify-center shrink-0"
