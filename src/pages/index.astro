---
// PERF_OPT: Enabled static prerendering to drastically improve FCP and LCP. Remove if SSR is needed.
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Image } from "astro:assets";
import aiReceptionistImg from "../../public/images/AI-Receptionist-3.png";
import { Footer } from "@/components/Footer";
import { AreaPartnerBooking } from "@/components/AreaPartnerBooking";
import { generateFAQSchema } from "@/lib/seo-data";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Amberly Digital",
  image: "https://amberlydigital.com/og-image.png",
  "@id": "https://amberlydigital.com/#localbusiness",
  url: "https://amberlydigital.com",
  telephone: "1300 AMBERLY",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Level 3, 100 George Street",
    addressLocality: "Sydney",
    addressRegion: "NSW",
    postalCode: "2000",
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -33.8688,
    longitude: 151.2093,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "00:00",
    closes: "23:59",
  },
  sameAs: [
    "https://www.facebook.com/amberlydigital",
    "https://www.linkedin.com/company/amberlydigital",
  ],
};

const faqItems = [
  {
    q: "Will AI replace my office staff?",
    a: "No. AI tools are designed to handle repetitive tasks like answering common questions, booking jobs, and collecting customer information, allowing your team to focus on higher-value work.",
  },
  {
    q: "What can an AI Receptionist actually do?",
    a: "An AI Receptionist can answer calls, qualify leads, collect job details, schedule appointments, and respond to enquiries 24/7â€”even when you're on-site or after business hours.",
  },
  {
    q: "Can AI help me respond to leads faster?",
    a: "Yes. AI can instantly reply to missed calls, web enquiries, and form submissions, helping you contact potential customers before they move on to a competitor.",
  },
  {
    q: "Is AI difficult to use?",
    a: "Not at all. We set everything up for you and integrate it into your existing workflow, so you can start using it without learning complicated software.",
  },
  {
    q: "How much time can AI save my business?",
    a: "Many businesses spend hours each week answering calls, chasing leads, and handling admin tasks. AI automates much of this work, helping you focus on core operations and growing your business.",
  },
];

const faqSchemaJson = generateFAQSchema(faqItems);

const capabilities = [
  {
    label: "AI Automation",
    link: "/services/ai-automation-integration",
    color: "bg-[#FCD34D] hover:bg-[#FBBF24]", // Warm amber
    icon: `<svg class="w-5 h-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>`,
  },
  {
    label: "Voice Agents",
    link: "/services/ai-receptionist",
    color: "bg-[#F9A8D4] hover:bg-[#F472B6]", // Pink
    icon: `<svg class="w-5 h-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>`,
  },
  {
    label: "AI Image Gen.",
    link: "/free-image-generation",
    color: "bg-[#A4E8D7] hover:bg-[#7BD9C2]", // Mint
    icon: `<svg class="w-5 h-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>`,
  },
  {
    label: "AI Video Gen.",
    link: "/free-video-generation",
    color: "bg-[#87E6F9] hover:bg-[#58D3EE]", // Sky blue
    icon: `<svg class="w-5 h-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8Z"></path><rect width="14" height="12" x="2" y="6" rx="2" ry="2"></rect></svg>`,
  },
  {
    label: "Startup MVPs",
    link: "/services/mvp-development",
    color: "bg-[#C084FC] hover:bg-[#A855F7]", // Lavender/Purple
    icon: `<svg class="w-5 h-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>`,
  },
  {
    label: "SaaS Product",
    link: "/services/saas-product-development",
    color: "bg-[#FDE047] hover:bg-[#FACC15]", // Yellow/Gold
    icon: `<svg class="w-5 h-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg>`,
  },
  {
    label: "AI Development",
    link: "/services/ai-development",
    color: "bg-[#A3E635] hover:bg-[#84CC16]", // Lime Green
    icon: `<svg class="w-5 h-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>`,
  },
];
---

<BaseLayout>
  <!-- Schema.org LocalBusiness JSON-LD Dynamic Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaJson)} />

  <Navbar />
  <!-- LIVE ACTIVITY BANNER -->
  <div
    class="bg-amber-500 border-b-2 border-slate-950 py-2.5 px-4 text-center text-slate-950 text-xs font-mono font-black uppercase tracking-widest flex items-center justify-center gap-2 flex-wrap"
  >
    <svg
      class="w-4 h-4 text-slate-950 fill-current animate-pulse"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      ><path
        d="M17.66 11.2C17.43 10.9 17.15 10.64 16.89 10.38C16.22 9.78 15.46 9.35 14.82 8.72C13.33 7.26 13 4.85 13.95 3C13 3.23 12.17 3.75 11.46 4.32C8.87 6.4 7.85 10.07 9.07 13.22C9.11 13.32 9.15 13.42 9.15 13.55C9.15 13.77 9 13.97 8.8 14.05C8.57 14.15 8.33 14.09 8.14 13.93C8.08 13.88 8.04 13.83 8 13.76C6.87 12.33 6.69 10.28 7.45 8.64C5.78 10 4.87 12.3 5 14.47C5.06 14.97 5.12 15.47 5.29 15.97C5.43 16.57 5.7 17.17 6 17.7C7.08 19.43 8.95 20.67 10.96 20.92C13.1 21.19 15.39 20.8 17.03 19.32C18.86 17.66 19.5 15 18.56 12.72L18.43 12.46C18.22 12 17.66 11.2 17.66 11.2Z"
      ></path></svg
    >
    <span
      >Live Tools Available Now â€” No Sign-Up Required. Test Your AI &
      Automation Readiness in 10 Seconds.</span
    >
    <!-- <a
      href="/ai-studio"
      class="ml-2 underline underline-offset-2 hover:text-slate-800 transition-colors"
      >Try Free â†’</a
    > -->
  </div>

  <!-- CORE HERO SECTION - THE GEOMETRIC BALANCE HERO MATRIX -->
  <header
    class="border-b-2 border-slate-950 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-50 via-slate-300 to-slate-500"
    id="agency-hero"
  >
    <div class="max-w-8xl mx-auto px-6 lg:px-12">
      <div
        class="flex flex-col items-center justify-center text-center min-h-[580px] pt-4 lg:pt-6 pb-12 lg:pb-16 gap-8 max-w-5xl mx-auto"
      >
        <!-- Hero Core Message (Centered) -->
        <div class="flex flex-col justify-center relative py-6 w-full">
          <h1
            class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black font-display leading-none mb-6 text-slate-950 uppercase tracking-tight"
          >
            Experience Our <br class="hidden sm:block" /><span
              class="text-amber-500">AI Platform.</span
            >
          </h1>
          <p
            class="text-base lg:text-xl text-slate-600 leading-relaxed mb-10 font-medium max-w-3xl mx-auto"
          >
            Explore real AI tools and integrations, from image generation to
            video creation with keyframes and many more.
          </p>

          <!-- Models Grid in Hero -->
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 text-left w-full mt-4"
          >
            <a
              href="/ai-studio?mode=i2i"
              class="bg-gradient-to-br from-[#A4E8D7] to-[#7BD9C2] border-2 border-slate-950 p-5 rounded-[2rem] flex flex-col transition-all duration-300 hover:-translate-y-2 hover:shadow-[6px_6px_0px_0px_rgba(2,6,23,1)] group text-left relative"
            >
              <div class="px-1 mt-2 flex items-center justify-between gap-4">
                <div>
                  <div
                    class="w-10 h-10 rounded-lg bg-slate-950 flex items-center justify-center mb-4 shadow-lg text-white"
                  >
                    <svg
                      class="w-5 h-5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><rect width="18" height="18" x="3" y="3" rx="2" ry="2"
                      ></rect><circle cx="9" cy="9" r="2"></circle><path
                        d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"
                      ></path></svg
                    >
                  </div>
                  <h3
                    class="text-xl font-bold text-slate-950 tracking-tight mb-1"
                  >
                    AI Image Generator
                  </h3>
                  <p class="text-[13px] text-slate-800 font-medium">
                    Create stunning AI images instantly.
                  </p>
                </div>
                <div
                  class="w-10 h-10 rounded-full bg-slate-950/10 flex items-center justify-center text-slate-950 group-hover:bg-slate-950 group-hover:text-white transition-colors shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </div>
              </div>
            </a>

            <a
              href="/ai-studio?mode=t2v"
              class="bg-gradient-to-br from-[#87E6F9] to-[#58D3EE] border-2 border-slate-950 p-5 rounded-[2rem] flex flex-col transition-all duration-300 hover:-translate-y-2 hover:shadow-[6px_6px_0px_0px_rgba(2,6,23,1)] group text-left relative"
            >
              <div class="px-1 mt-2 flex items-center justify-between gap-4">
                <div>
                  <div
                    class="w-10 h-10 rounded-lg bg-slate-950 flex items-center justify-center mb-4 shadow-lg text-white"
                  >
                    <svg
                      class="w-5 h-5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
                    >
                  </div>
                  <h3
                    class="text-xl font-bold text-slate-950 tracking-tight mb-1"
                  >
                    AI Video Generator
                  </h3>
                  <p class="text-[13px] text-slate-800 font-medium">
                    Turn text into cinematic video.
                  </p>
                </div>
                <div
                  class="w-10 h-10 rounded-full bg-slate-950/10 flex items-center justify-center text-slate-950 group-hover:bg-slate-950 group-hover:text-white transition-colors shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </div>
              </div>
            </a>

            <a
              href="/services/ai-receptionist"
              class="bg-gradient-to-br from-[#F9A8D4] to-[#F472B6] border-2 border-slate-950 p-5 rounded-[2rem] flex flex-col transition-all duration-300 hover:-translate-y-2 hover:shadow-[6px_6px_0px_0px_rgba(2,6,23,1)] group text-left relative"
            >
              <div class="px-1 mt-2 flex items-center justify-between gap-4">
                <div>
                  <div
                    class="w-10 h-10 rounded-lg bg-slate-950 flex items-center justify-center mb-4 shadow-lg text-white"
                  >
                    <svg
                      class="w-5 h-5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                      ></path></svg
                    >
                  </div>
                  <h3
                    class="text-xl font-bold text-slate-950 tracking-tight mb-1"
                  >
                    AI Voice Agent
                  </h3>
                  <p class="text-[13px] text-slate-800 font-medium">
                    Deploy 24/7 natural-sounding call assistants.
                  </p>
                </div>
                <div
                  class="w-10 h-10 rounded-full bg-slate-950/10 flex items-center justify-center text-slate-950 group-hover:bg-slate-950 group-hover:text-white transition-colors shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- CAPABILITIES SHOWCASE SECTION -->
  <section
    class="py-12 bg-white border-b-2 border-slate-950 relative overflow-hidden scroll-reveal"
    id="capabilities-section"
  >
    <div class="max-w-8xl mx-auto px-6 lg:px-12 mb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >⚡ WHAT WE BUILD</span
          >
          <h2
            class="text-4xl lg:text-5xl font-black text-slate-950 uppercase tracking-tight font-display leading-tight"
          >
            Our Solutions
          </h2>
        </div>
      </div>
    </div>

    <!-- Ticker Outer Wrapper -->
    <div class="marquee-container py-4">
      <div class="marquee-fade-left"></div>
      <div class="marquee-fade-right"></div>

      <!-- Ticker Track (Repeated for seamless loop) -->
      <div class="marquee-track">
        <!-- First Set -->
        {
          capabilities.map((item) => (
            <a
              href={item.link}
              class={`flex items-center gap-4 border-2 border-slate-950 px-6 py-4.5 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] ${item.color} select-none`}
            >
              <div class="flex items-center justify-center shrink-0 w-10 h-10 bg-white/40 border border-slate-950/10 rounded-none text-slate-950">
                <Fragment set:html={item.icon} />
              </div>
              <span class="font-display font-black text-slate-950 text-lg uppercase tracking-tight whitespace-nowrap">
                {item.label}
              </span>
            </a>
          ))
        }
        <!-- Second Set (Duplicate for seamless loop) -->
        {
          capabilities.map((item) => (
            <a
              href={item.link}
              class={`flex items-center gap-4 border-2 border-slate-950 px-6 py-4.5 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] ${item.color} select-none`}
            >
              <div class="flex items-center justify-center shrink-0 w-10 h-10 bg-white/40 border border-slate-950/10 rounded-none text-slate-950">
                <Fragment set:html={item.icon} />
              </div>
              <span class="font-display font-black text-slate-950 text-lg uppercase tracking-tight whitespace-nowrap">
                {item.label}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <style>
      @keyframes marquee {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-50%);
        }
      }

      .marquee-container {
        overflow: hidden;
        white-space: nowrap;
        position: relative;
        width: 100%;
      }

      .marquee-track {
        display: inline-flex;
        gap: 2rem;
        animation: marquee 25s linear infinite;
        width: max-content;
      }

      /* Pause on hover to allow clicking links */
      .marquee-track:hover {
        animation-play-state: paused;
      }

      /* Fading gradient overlays on the sides */
      .marquee-fade-left {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 100px;
        background: linear-gradient(to right, white, transparent);
        z-index: 10;
        pointer-events: none;
      }

      .marquee-fade-right {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        width: 100px;
        background: linear-gradient(to left, white, transparent);
        z-index: 10;
        pointer-events: none;
      }
    </style>
  </section>

  <!-- A PRACTICAL APPROACH SECTION -->
  <section
    class="py-20 bg-white border-b-2 border-slate-950 scroll-reveal"
    id="agency-process"
  >
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="max-w-3xl mb-16">
        <span
          class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-3"
          >⚡ HOW WE WORK</span
        >
        <h2
          class="text-4xl sm:text-5xl lg:text-6xl font-display font-black text-slate-950 uppercase tracking-tight leading-none mb-4"
        >
          A Practical Approach
        </h2>
        <p
          class="text-slate-600 text-lg sm:text-xl font-semibold leading-relaxed"
        >
          We don't build AI for the sake of it. We map your real workflows,
          identify where AI creates genuine leverage, and build systems that
          actually get used.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <span
            class="text-4xl sm:text-5xl font-display font-black text-amber-500"
            >01</span
          >
          <h3
            class="text-xl sm:text-2xl font-bold font-display text-slate-950 uppercase tracking-tight"
          >
            Map Your Workflows
          </h3>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            We start by understanding how your team actually works — what's
            manual, what's repetitive, and where an AI agent, RAG system, or LLM
            integration would save the most time. We scope precisely before
            writing a single line of code.
          </p>
        </div>
        <div class="space-y-4">
          <span
            class="text-4xl sm:text-5xl font-display font-black text-slate-950"
            >02</span
          >
          <h3
            class="text-xl sm:text-2xl font-bold font-display text-slate-950 uppercase tracking-tight"
          >
            Build the AI System
          </h3>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            We build your custom AI solution — whether that's a fine-tuned LLM,
            a multi-step agent, a retrieval-augmented knowledge base, or a
            workflow automation layer. You're in the loop at every checkpoint,
            not just at launch.
          </p>
        </div>
        <div class="space-y-4">
          <span
            class="text-4xl sm:text-5xl font-display font-black text-amber-500"
            >03</span
          >
          <h3
            class="text-xl sm:text-2xl font-bold font-display text-slate-950 uppercase tracking-tight"
          >
            Deploy, Test & Hand Over
          </h3>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
