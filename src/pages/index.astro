      <div class="mt-4 flex justify-center gap-2" id="slider-pagination">
        <!-- These dots will be synced via JS -->
        <button
          class="w-10 h-2 rounded-full bg-slate-900 transition-colors"
          aria-label="Go to slide 1"></button>
        <button
          class="w-10 h-2 rounded-full bg-slate-200 hover:bg-slate-300 transition-colors"
          aria-label="Go to slide 2"></button>
        <button
          class="w-10 h-2 rounded-full bg-slate-200 hover:bg-slate-300 transition-colors"
          aria-label="Go to slide 3"></button>
