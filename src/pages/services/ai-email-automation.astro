---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Footer } from "@/components/Footer";
import { AreaPartnerBooking } from "@/components/AreaPartnerBooking";
import { SERVICES, CITIES, generateFAQSchema } from "@/lib/seo-data";
import {
  Globe,
  CheckCircle,
  Mail,
  Calendar,
  Flame,
  ShieldCheck,
  ArrowRight,
} from "lucide-react";

const service = SERVICES["ai-email-automation"];

const faqItems = [
  {
    q: "Will my emails look like robotic spam?",
    a: "No. Our templates are designed to read like personalized, plain-text emails typed directly from your personal inbox. We dynamically inject job-specific details (like customer name, job description, and quoting values) to ensure authentic delivery.",
  },
  {
    q: "How does it connect to my quoting software?",
    a: "We connect our automation layer to your job management tools (ServiceM8, Fergus, or ServiceTitan) or accounting suite (Xero, MYOB) using secure webhook interfaces. The moment a quote status changes, the sequence adapts or stops instantly.",
  },
  {
    q: "Does it stop sending emails once the customer responds or approves?",
    a: "Yes. Our systems use smart exit conditions. If a customer replies to the email or approves the quote in your CRM, the follow-up loop terminates immediately so we never send redundant messages.",
  },
  {
    q: "Can this help me get more Google Reviews?",
    a: "Yes. A key part of the email sequence is the post-job trigger. Once a job is marked 'Completed' or 'Invoiced', the system sends a polite review request email with a direct link to your Google Maps listing, significantly increasing your rating velocity.",
  },
];

const faqSchemaJson = generateFAQSchema(faqItems);
---

<BaseLayout
  title="Automated AI Email Follow-Ups & Reviews for Tradies | Amberly Digital"
  description="Boost your quote approval rates automatically. Our AI email engine follows up open quotes, nurtures leads, and captures Google reviews on autopilot."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaJson)} />

  <Navbar />

  <!-- TOP STRIP -->
  <div
    class="bg-amber-500 border-b-2 border-slate-950 py-2.5 px-4 text-center text-slate-950 text-xs font-mono font-black uppercase tracking-widest flex items-center justify-center gap-2"
  >
    <Mail className="w-4 h-4 animate-bounce shrink-0 text-slate-950" />
    <span>📧 DYNAMIC QUOTE FOLLOW-UP & GOOGLE REVIEW ENGINES SYSTEM ACTIVE</span
    >
  </div>

  <main class="bg-white">
    <!-- HERO SECTION: PROBLEM + OUTCOME -->
    <section
      class="border-b-2 border-slate-950 py-16 lg:py-24 bg-slate-50 relative overflow-hidden"
    >
      <div
        class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <div class="max-w-5xl mx-auto px-6 lg:px-12 space-y-8 relative">
        <span
          class="text-xs font-mono font-black text-amber-600 border border-amber-300 bg-amber-100 px-3 py-1 w-fit block uppercase tracking-widest"
        >
          📧 QUOTE NURTURING
        </span>
        <h1
          class="text-4xl sm:text-5xl lg:text-7xl font-black font-display text-slate-950 uppercase tracking-tight leading-none"
        >
          Send Quotes. <br />
          <span class="text-amber-500">Close More Bookings.</span>
        </h1>

        <!-- Problem & Outcome Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6">
          <div
            class="border-2 border-slate-900 bg-white p-6 shadow-[4px_4px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="text-[10px] font-mono font-black text-red-500 uppercase tracking-widest block mb-2"
              >✖ THE PROBLEM: SENT QUOTES FORGOTTEN</span
            >
            <p class="text-sm text-slate-700 leading-relaxed font-semibold">
              You quote a $4,500 sewer repair or hot water system replacement.
              Because you're busy running on-site jobs, you don't call to follow
              up. The quote sits in your CRM, goes cold, and the client hires a
              competitor who followed up first. Manual follow-up takes hours of
              administration time.
            </p>
          </div>
          <div
            class="border-2 border-amber-500 bg-slate-900 p-6 shadow-[4px_4px_0px_rgba(245,158,11,1)] text-white"
          >
            <span
              class="text-[10px] font-mono font-black text-amber-400 uppercase tracking-widest block mb-2"
              >✔ THE OUTCOME: AUTOPILOT FOLLOW-UPS & REVIEWS</span
            >
            <p class="text-sm text-slate-350 leading-relaxed">
              Our AI email system monitors quote states in your CRM. If
              unapproved after 24 hours, it triggers a custom follow-up pathway
              that checks in, answers queries, and prompts them to secure
              booking dates. Once completed, it triggers a Google review
              sequence to build your online authority.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS: 3 SIMPLE STEPS -->
    <section class="py-16 lg:py-20 border-b-2 border-slate-950">
      <div class="max-w-5xl mx-auto px-6 lg:px-12">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span
            class="text-xs font-mono font-black text-amber-600 uppercase tracking-widest block mb-2"
            >METHODOLOGY</span
          >
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Our 3-Step Email Automation Funnel
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >01</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              CRM Integration
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              We sync our email engine with your existing job management tools
              (ServiceM8) or accounting software (Xero) using API hook events.
            </p>
          </div>
          <!-- Step 2 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >02</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              Nurture Triggers
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              When a quote is sent, the system schedules personalized follow-up
              checkpoints on Day 1, Day 3, and Day 7, stopping automatically
              when approved.
            </p>
          </div>
          <!-- Step 3 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >03</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              Review Syndication
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              The moment the job invoice is marked paid, the system fires a
              post-delivery review link request, boosting your Google rating
              authority.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- EXAMPLE RESULT: EMAIL SEQUENCE TIMELINE MOCKUP -->
    <section class="py-16 lg:py-20 bg-slate-50 border-b-2 border-slate-950">
      <div
        class="max-w-8xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
      >
        <!-- Text Column -->
        <div class="lg:col-span-5 space-y-6">
          <span
            class="text-xs font-mono font-black text-amber-600 border border-amber-300 bg-amber-100 px-3 py-1 w-fit block uppercase tracking-widest"
          >
            SEQUENCE PATHWAY
          </span>
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            The Follow-Up Timeline
          </h2>
          <p class="text-sm text-slate-650 leading-relaxed font-medium">
            This dashboard demonstrates how the follow-up timing sequences run.
            Rather than aggressive templates, the emails are configured as
            simple plain-text notes, which yield double the open rates of heavy
            HTML designs.
          </p>
          <div
            class="p-4 bg-white border border-slate-200 flex items-start gap-3"
          >
            <CheckCircle className="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
            <p class="text-xs text-slate-600">
              <strong>38% average increase in quote approvals</strong> across plumbing
              trade assets when followed up within 72 hours.
            </p>
          </div>
        </div>

        <!-- Timeline Visual Mockup -->
        <div
          class="lg:col-span-7 bg-slate-900 border-2 border-slate-950 p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] text-white space-y-6 font-mono text-xs"
        >
          <h4
            class="text-xs font-black uppercase text-slate-400 tracking-wider flex items-center gap-2 border-b border-slate-800 pb-3"
          >
            <Mail className="w-4 h-4 text-amber-500" /> EMAIL SEQUENCE PIPELINE VISUALIZER
          </h4>

          {/* Timeline Step 1 */}
          <div class="relative pl-8 border-l-2 border-slate-800">
            <span
              class="absolute -left-[9px] top-0.5 w-4.5 h-4.5 bg-slate-900 border-2 border-slate-700 flex items-center justify-center font-black text-[9px] text-slate-400"
              >1</span
            >
            <div
              class="bg-slate-950 p-3.5 border border-slate-850 flex flex-col sm:flex-row sm:items-center justify-between gap-2"
            >
              <div>
                <span
                  class="text-[9px] text-amber-400 font-bold block uppercase tracking-wider"
                  >DAY 0: SYSTEM INITIALIZATION</span
                >
                <span class="text-white font-bold">Quote Sent to Homeowner</span
                >
              </div>
              <span
                class="text-[9px] bg-slate-800 px-2 py-0.5 uppercase tracking-widest text-slate-400"
                >Trigger active</span
              >
            </div>
          </div>

          {/* Timeline Step 2 */}
          <div class="relative pl-8 border-l-2 border-slate-800">
            <span
              class="absolute -left-[9px] top-0.5 w-4.5 h-4.5 bg-slate-900 border-2 border-slate-700 flex items-center justify-center font-black text-[9px] text-slate-400"
              >2</span
            >
            <div
              class="bg-slate-950 p-3.5 border border-slate-850 flex flex-col sm:flex-row sm:items-center justify-between gap-2"
            >
              <div>
                <span
                  class="text-[9px] text-amber-400 font-bold block uppercase tracking-wider"
                  >DAY 1: CONVERSATIONAL CHECK-IN</span
                >
                <span class="text-white font-bold"
                  >"Just checking if you had questions about the quote?"</span
                >
              </div>
              <span
                class="text-[9px] bg-emerald-950 border border-emerald-900 px-2 py-0.5 uppercase tracking-widest text-emerald-400 font-black"
                >Delivered</span
              >
            </div>
          </div>

          {/* Timeline Step 3 */}
          <div class="relative pl-8 border-l-2 border-slate-800">
            <span
              class="absolute -left-[9px] top-0.5 w-4.5 h-4.5 bg-slate-900 border-2 border-slate-700 flex items-center justify-center font-black text-[9px] text-slate-400"
              >3</span
            >
            <div
              class="bg-slate-950 p-3.5 border border-slate-850 flex flex-col sm:flex-row sm:items-center justify-between gap-2"
            >
              <div>
                <span
                  class="text-[9px] text-amber-400 font-bold block uppercase tracking-wider"
                  >DAY 3: AVAILABILITY ALERT</span
                >
                <span class="text-white font-bold"
                  >"Checking if you want to hold our dispatch slot for next
                  week?"</span
                >
              </div>
              <span
                class="text-[9px] bg-slate-850 px-2 py-0.5 uppercase tracking-widest text-slate-500"
                >Scheduled</span
              >
            </div>
          </div>

          {/* Timeline Step 4 */}
          <div class="relative pl-8">
            <span
              class="absolute -left-[9px] top-0.5 w-4.5 h-4.5 bg-slate-900 border-2 border-slate-700 flex items-center justify-center font-black text-[9px] text-slate-400"
              >4</span
            >
            <div
              class="bg-slate-950 p-3.5 border border-slate-850 flex flex-col sm:flex-row sm:items-center justify-between gap-2"
            >
              <div>
                <span
                  class="text-[9px] text-amber-400 font-bold block uppercase tracking-wider"
                  >POST-JOB: REVIEW TRIGGER</span
                >
                <span class="text-white font-bold"
                  >"Send review invite link 1 hour after invoice is paid"</span
                >
              </div>
              <span
                class="text-[9px] bg-slate-850 px-2 py-0.5 uppercase tracking-widest text-slate-500"
                >On hold</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY TRADIES USE IT: BENEFITS -->
    <section class="py-16 lg:py-24 border-b-2 border-slate-950">
      <div class="max-w-5xl mx-auto px-6 lg:px-12">
        <div class="mb-14 text-center max-w-2xl mx-auto">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >BENEFITS</span
          >
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Structured For Quote Conversions
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            service.benefits.map((benefit, idx) => (
              <div class="bg-slate-50 border-2 border-slate-950 p-6 flex items-start gap-4 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
                <div class="w-10 h-10 bg-amber-500 border-2 border-slate-950 text-slate-950 flex items-center justify-center shrink-0 shadow-[2px_2px_0px_rgba(0,0,0,1)]">
                  <span class="font-mono font-black text-xs">0{idx + 1}</span>
                </div>
                <div>
                  <h4 class="text-base font-bold font-display uppercase tracking-tight text-slate-950 mb-2">
                    {service.features[idx]}
                  </h4>
                  <p class="text-xs text-slate-600 leading-relaxed font-semibold">
                    {benefit}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ: SERVICE-SPECIFIC -->
    <section class="py-16 lg:py-20 bg-slate-50 border-b-2 border-slate-950">
      <div class="max-w-3xl mx-auto px-6 lg:px-12">
        <div class="mb-12 text-center">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >FAQ</span
          >
          <h2
            class="text-2xl sm:text-3xl font-black font-display text-slate-950 uppercase tracking-tight"
          >
            Email Automation FAQ
          </h2>
        </div>

        <div class="space-y-4">
          {
            faqItems.map((faq) => (
              <div class="border-2 border-slate-200 p-5 bg-white shadow-sm">
                <h3 class="text-sm font-black text-slate-950 uppercase tracking-tight mb-2">
                  {faq.q}
                </h3>
                <p class="text-xs text-slate-650 leading-relaxed font-semibold">
                  {faq.a}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA STRIP -->
    <section class="bg-amber-50 py-16 border-b-2 border-slate-950">
      <div
        class="max-w-4xl mx-auto px-6 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-8 text-slate-950"
      >
        <div>
          <h2
            class="text-3xl sm:text-4xl font-black font-display uppercase tracking-tight leading-tight"
          >
            Stop Letting Open Quotes<br class="hidden sm:block" /> Go Cold.
          </h2>
          <p class="text-slate-800 text-sm font-bold mt-2">
            Claim your follow-up sequence. We configure webhooks to sync with
            your invoicing software in 5 days.
          </p>
        </div>
        <a
          href="/#onboarding-form"
          class="shrink-0 bg-white text-slate-950 font-black py-4 px-8 text-xs tracking-widest uppercase transition-all duration-200 border-2 border-slate-950 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 hover:shadow-none"
        >
          Book Strategy Call →
        </a>
      </div>
    </section>

    <!-- REGIONAL CITIES SELECTOR -->
    <section class="py-16">
      <div class="max-w-8xl mx-auto px-6 lg:px-12">
        <div class="max-w-2xl mb-12">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >DYNAMIC REGIONAL DEPLOYMENTS</span
          >
          <h2
            class="text-3xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Deploy In Your Capital City
          </h2>
          <p class="text-slate-605 mt-2 text-sm font-medium">
            Select your capital city region to see how we adjust geo-coordinates
            and schema files for your local suburbs.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
          {
            Object.entries(CITIES).map(([cityKey, city]) => (
              <div class="bg-white border-2 border-slate-950 p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
                    <span class="text-lg font-black font-display text-slate-900 uppercase">
                      {city.name}
                    </span>
                    <span class="text-[10px] font-mono font-bold bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 uppercase">
                      {city.state}
                    </span>
                  </div>
                  <p class="text-[10px] text-slate-500 font-mono mb-4 leading-normal">
                    Includes suburbs: {city.suburbs.slice(0, 3).join(", ")}...
                  </p>
                </div>
                <a
                  href={`/services/ai-email-automation/${cityKey}`}
                  class="inline-flex items-center justify-between text-xs font-mono font-black uppercase text-slate-950 hover:text-amber-600 border-t border-slate-100 pt-3"
                >
                  <>
                    <span>Target {city.name}</span>
                    <span>→</span>
                  </>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer client:visible />
</BaseLayout>
