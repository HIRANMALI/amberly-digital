---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Footer } from "@/components/Footer";
import { AreaPartnerBooking } from "@/components/AreaPartnerBooking";
import { SERVICES, CITIES, generateFAQSchema } from "@/lib/seo-data";
import {
  Phone,
  CheckCircle,
  Play,
  Calendar,
  ShieldCheck,
  ArrowRight,
} from "lucide-react";

const service = SERVICES["ai-receptionist"];

const faqItems = [
  {
    q: "Can the AI handle Australian accents and trade terminology?",
    a: "Yes. Our AI voice engines are specifically fine-tuned for Australian accents and understand trade-specific terminology like 'temper valve', 'cctv drain survey', 'high-pressure water jetter', and 'mains pressure'.",
  },
  {
    q: "How does it schedule jobs in my calendar?",
    a: "The AI integrates with popular booking tools (like ServiceM8, Calendly, or Google Calendar). It reviews your real-time availability and books time slots matching your dispatch parameters.",
  },
  {
    q: "What happens if a customer has a complex query the AI doesn't know?",
    a: "If a caller asks a highly specialized question, the AI politely collects their contact details, notes the issue, and marks the lead as 'requires human follow-up', notifying you instantly via SMS or Slack.",
  },
  {
    q: "Is there a limit to how many concurrent calls the AI can answer?",
    a: "No. Unlike a human receptionist, the AI can handle unlimited concurrent calls. If 10 homeowners call you at the same time during a localized storm or pipe freeze, all 10 are answered instantly with zero wait times.",
  },
];

const faqSchemaJson = generateFAQSchema(faqItems);
---

<BaseLayout
  title="24/7 AI Voice Receptionist for Tradies & Plumbers | Amberly Digital"
  description="Never miss another emergency plumbing job. Our conversational AI voice receptionist answers calls 24/7, qualifies leads, and schedules bookings."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaJson)} />

  <Navbar />

  <!-- TOP STRIP -->
  <div
    class="bg-amber-500 border-b-2 border-slate-950 py-2.5 px-4 text-center text-slate-950 text-xs font-mono font-black uppercase tracking-widest flex items-center justify-center gap-2"
  >
    <Phone className="w-4 h-4 animate-pulse shrink-0 text-slate-950" />
    <span>24/7 INBOUND AI CONVERSATIONAL VOICE AGENT ACTIVE</span>
  </div>

  <main class="bg-white">
    <!-- HERO SECTION: PROBLEM + OUTCOME -->
    <section
      class="border-b-2 border-slate-950 py-16 lg:py-24 bg-slate-50 relative overflow-hidden"
    >
      <div
        class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <div class="max-w-5xl mx-auto px-6 lg:px-12 space-y-8 relative">
        <span
          class="text-xs font-mono font-black text-amber-600 border border-amber-300 bg-amber-100 px-3 py-1 w-fit block uppercase tracking-widest"
        >
          📞 24/7 INBOUND RECEPTION
        </span>
        <h1
          class="text-4xl sm:text-5xl lg:text-7xl font-black font-display text-slate-950 uppercase tracking-tight leading-none"
        >
          Answer Instantly. <br />
          <span class="text-amber-500">Secure the Dispatch.</span>
        </h1>

        <!-- Problem & Outcome Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6">
          <div
            class="border-2 border-slate-900 bg-white p-6 shadow-[4px_4px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="text-[10px] font-mono font-black text-red-500 uppercase tracking-widest block mb-2"
              >✖ THE PROBLEM: VOICE-MAILS DON'T BOOK JOBS</span
            >
            <p class="text-sm text-slate-700 leading-relaxed font-semibold">
              Homeowners call you at 10 PM for emergency pipe bursts. If you're
              on site, driving, or sleeping, the call goes to voicemail. Over
              60% of emergency callers hang up and call the next listing on
              Google Maps without leaving a message. Hiring a late-night
              answering service is expensive and prone to error.
            </p>
          </div>
          <div
            class="border-2 border-amber-500 bg-slate-900 p-6 shadow-[4px_4px_0px_rgba(245,158,11,1)] text-white"
          >
            <span
              class="text-[10px] font-mono font-black text-amber-400 uppercase tracking-widest block mb-2"
              >✔ THE OUTCOME: ZERO MISSED LEADS</span
            >
            <p class="text-sm text-slate-350 leading-relaxed">
              Our AI receptionist picks up within 2 rings, qualified with
              standard plumber queries (e.g. *where is the leak?*, *can you shut
              off your main valve?*), confirms your emergency call-out fee,
              schedules the job into your calendar (ServiceM8), and sends a
              confirmation text to the customer. You wake up with jobs ready in
              your schedule.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS: 3 SIMPLE STEPS -->
    <section class="py-16 lg:py-20 border-b-2 border-slate-950">
      <div class="max-w-5xl mx-auto px-6 lg:px-12">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span
            class="text-xs font-mono font-black text-amber-600 uppercase tracking-widest block mb-2"
            >METHODOLOGY</span
          >
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Our 3-Step Setup Process
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >01</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              Call Routing
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              We provide an dedicated routing line. You can forward your
              business number automatically when busy, during specific hours, or
              24/7/365.
            </p>
          </div>
          <!-- Step 2 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >02</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              Knowledge Base Config
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              We construct a custom knowledge manual containing your rates,
              boundaries, service suburbs, and job policies, training the AI to
              represent your business perfectly.
            </p>
          </div>
          <!-- Step 3 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >03</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              Calendar & CRM Sync
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              The receptionist is integrated with ServiceM8, Xero, or Google
              Calendar, injecting lead qualifications and dispatch jobs
              instantly.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- EXAMPLE RESULT: CALL FLOW DIAGRAM & CONVERSATION TRANSCRIPT -->
    <section class="py-16 lg:py-20 bg-slate-50 border-b-2 border-slate-950">
      <div
        class="max-w-8xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
      >
        <!-- Text Column -->
        <div class="lg:col-span-5 space-y-6">
          <span
            class="text-xs font-mono font-black text-amber-600 border border-amber-300 bg-amber-100 px-3 py-1 w-fit block uppercase tracking-widest"
          >
            LIVE ARCHITECTURE
          </span>
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            How The Call Flows
          </h2>
          <p class="text-sm text-slate-650 leading-relaxed font-medium">
            This diagram demonstrates the direct automated pipeline. An incoming
            call is intercepted, details are gathered, eligibility is filtered,
            and coordinates are logged directly into your dispatch tools without
            human delay.
          </p>
          <div
            class="p-4 bg-white border border-slate-200 flex items-start gap-3"
          >
            <CheckCircle className="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
            <p class="text-xs text-slate-600">
              <strong>99.8% response rate</strong>. The system can support 50+
              concurrent phone call streams simultaneously.
            </p>
          </div>
        </div>

        <!-- Visual Call Flow Diagram + Script Mockup -->
        <div class="lg:col-span-7 space-y-6">
          {/* Neobrutalist Flow Cards */}
          <div
            class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-center"
          >
            <div
              class="bg-white border-2 border-slate-950 p-4 shadow-[3px_3px_0px_rgba(0,0,0,1)] relative flex flex-col justify-between"
            >
              <span class="text-[9px] text-slate-400 block font-bold"
                >STAGE 01</span
              >
              <span
                class="text-xs font-black text-slate-900 block mt-1 uppercase"
                >1. Inbound Call</span
              >
              <span class="text-[10px] text-amber-600 font-bold block mt-2"
                >📞 Handled in &lt;2s</span
              >
            </div>

            <div
              class="bg-white border-2 border-slate-950 p-4 shadow-[3px_3px_0px_rgba(0,0,0,1)] relative flex flex-col justify-between"
            >
              <span class="text-[9px] text-slate-400 block font-bold"
                >STAGE 02</span
              >
              <span
                class="text-xs font-black text-slate-900 block mt-1 uppercase"
                >2. AI Dialog</span
              >
              <span class="text-[10px] text-slate-500 font-bold block mt-2"
                >Qualifies details & fee</span
              >
            </div>

            <div
              class="bg-slate-900 border-2 border-slate-950 p-4 shadow-[3px_3px_0px_rgba(0,0,0,1)] text-white relative flex flex-col justify-between"
            >
              <span class="text-[9px] text-slate-400 block font-bold"
                >STAGE 03</span
              >
              <span class="text-xs font-black uppercase block mt-1"
                >3. CRM Sync</span
              >
              <span class="text-[10px] text-amber-400 font-black block mt-2"
                >✓ Job booked ServiceM8</span
              >
            </div>
          </div>

          {/* Transcript Simulator Mockup */}
          <div
            class="bg-slate-900 border-2 border-slate-950 p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] text-white"
          >
            <h4
              class="text-xs font-mono font-black uppercase text-slate-400 tracking-wider mb-4 flex items-center gap-2"
            >
              <Play className="w-4 h-4 text-amber-500 fill-current" /> DIALOGUE SCRIPT
              SIMULATOR
            </h4>

            <div
              class="space-y-3 font-mono text-xs max-h-[300px] overflow-y-auto"
            >
              <div class="flex gap-2">
                <span class="text-amber-400 font-black tracking-wider shrink-0"
                  >[AI Receptionist]:</span
                >
                <p class="text-slate-300">
                  "Thanks for calling Bondi Plumbing Services. This is Sarah,
                  your digital receptionist. Are you calling about a plumbing
                  emergency?"
                </p>
              </div>
              <div class="flex gap-2">
                <span class="text-slate-500 font-black tracking-wider shrink-0"
                  >[Homeowner]:</span
                >
                <p class="text-slate-100 italic">
                  "Yes, our kitchen pipe has burst and water is running all over
                  the tiles. Can someone come out tonight?"
                </p>
              </div>
              <div class="flex gap-2">
                <span class="text-amber-400 font-black tracking-wider shrink-0"
                  >[AI Receptionist]:</span
                >
                <p class="text-slate-300">
                  "I can book a tech to head out right away. Our emergency
                  callout rate is $180, which includes the first 30 minutes. Is
                  that okay, and what is your address?"
                </p>
              </div>
              <div class="flex gap-2">
                <span class="text-slate-500 font-black tracking-wider shrink-0"
                  >[Homeowner]:</span
                >
                <p class="text-slate-100 italic">
                  "Yes that's fine. The address is 14 Hall Street, Bondi Beach."
                </p>
              </div>
              <div class="flex gap-2">
                <span class="text-amber-400 font-black tracking-wider shrink-0"
                  >[AI Receptionist]:</span
                >
                <p class="text-slate-300">
                  "Perfect. I have booked your dispatch for our emergency team.
                  You will receive an SMS confirmation in the next 10 seconds.
                  We're on it."
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY TRADIES USE IT: BENEFITS -->
    <section class="py-16 lg:py-24 border-b-2 border-slate-950">
      <div class="max-w-5xl mx-auto px-6 lg:px-12">
        <div class="mb-14 text-center max-w-2xl mx-auto">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >BENEFITS</span
          >
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Constructed For Aussie Plumbers
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            service.benefits.map((benefit, idx) => (
              <div class="bg-slate-50 border-2 border-slate-950 p-6 flex items-start gap-4 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
                <div class="w-10 h-10 bg-amber-500 border-2 border-slate-950 text-slate-950 flex items-center justify-center shrink-0 shadow-[2px_2px_0px_rgba(0,0,0,1)]">
                  <span class="font-mono font-black text-xs">0{idx + 1}</span>
                </div>
                <div>
                  <h4 class="text-base font-bold font-display uppercase tracking-tight text-slate-950 mb-2">
                    {service.features[idx]}
                  </h4>
                  <p class="text-xs text-slate-600 leading-relaxed font-semibold">
                    {benefit}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ: SERVICE-SPECIFIC -->
    <section class="py-16 lg:py-20 bg-slate-50 border-b-2 border-slate-950">
      <div class="max-w-3xl mx-auto px-6 lg:px-12">
        <div class="mb-12 text-center">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >FAQ</span
          >
          <h2
            class="text-2xl sm:text-3xl font-black font-display text-slate-950 uppercase tracking-tight"
          >
            Voice Receptionist FAQ
          </h2>
        </div>

        <div class="space-y-4">
          {
            faqItems.map((faq) => (
              <div class="border-2 border-slate-200 p-5 bg-white shadow-sm">
                <h3 class="text-sm font-black text-slate-950 uppercase tracking-tight mb-2">
                  {faq.q}
                </h3>
                <p class="text-xs text-slate-650 leading-relaxed font-semibold">
                  {faq.a}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA STRIP -->
    <section class="bg-amber-50 py-16 border-b-2 border-slate-950">
      <div
        class="max-w-4xl mx-auto px-6 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-8 text-slate-950"
      >
        <div>
          <h2
            class="text-3xl sm:text-4xl font-black font-display uppercase tracking-tight leading-tight"
          >
            Stop Leaking Emergency<br class="hidden sm:block" /> Leads to Voicemail.
          </h2>
          <p class="text-slate-800 text-sm font-bold mt-2">
            Take back control of your phone lines. Get your voice agent
            configured in 7 days or less.
          </p>
        </div>
        <a
          href="/#onboarding-form"
          class="shrink-0 bg-white text-slate-950 font-black py-4 px-8 text-xs tracking-widest uppercase transition-all duration-200 border-2 border-slate-950 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 hover:shadow-none"
        >
          Book Strategy Call →
        </a>
      </div>
    </section>

    <!-- REGIONAL CITIES SELECTOR -->
    <section class="py-16">
      <div class="max-w-8xl mx-auto px-6 lg:px-12">
        <div class="max-w-2xl mb-12">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >DYNAMIC REGIONAL DEPLOYMENTS</span
          >
          <h2
            class="text-3xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Deploy In Your Capital City
          </h2>
          <p class="text-slate-600 mt-2 text-sm font-medium">
            Select your capital city region to see how we adjust geo-coordinates
            and schema files for your local suburbs.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
          {
            Object.entries(CITIES).map(([cityKey, city]) => (
              <div class="bg-white border-2 border-slate-950 p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
                    <span class="text-lg font-black font-display text-slate-900 uppercase">
                      {city.name}
                    </span>
                    <span class="text-[10px] font-mono font-bold bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 uppercase">
                      {city.state}
                    </span>
                  </div>
                  <p class="text-[10px] text-slate-500 font-mono mb-4 leading-normal">
                    Includes suburbs: {city.suburbs.slice(0, 3).join(", ")}...
                  </p>
                </div>
                <a
                  href={`/services/ai-receptionist/${cityKey}`}
                  class="inline-flex items-center justify-between text-xs font-mono font-black uppercase text-slate-950 hover:text-amber-600 border-t border-slate-100 pt-3"
                >
                  <>
                    <span>Target {city.name}</span>
                    <span>→</span>
                  </>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer client:visible />
</BaseLayout>
