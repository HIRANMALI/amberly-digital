---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Footer } from "@/components/Footer";
import { AreaPartnerBooking } from "@/components/AreaPartnerBooking";
import { SERVICES, CITIES, generateFAQSchema } from "@/lib/seo-data";
import {
  Code,
  CheckCircle,
  Smartphone,
  Zap,
  Flame,
  ShieldCheck,
  ArrowRight,
} from "lucide-react";

const service = SERVICES["custom-websites"];

const faqItems = [
  {
    q: "Why do you use Astro instead of WordPress?",
    a: "WordPress relies on databases and heavy plugins that slow down mobile load times. Astro compiles your website into lightweight, static HTML files. This means your website loads in under a second on mobile networks, which dramatically improves conversions and rankings.",
  },
  {
    q: "Will I lose my existing domain name and website history?",
    a: "No. We handle the entire domain migration process securely. We also configure 301 redirects to ensure you retain all existing SEO rankings, backlink history, and Google authority.",
  },
  {
    q: "How does the built-in suburb landing engine work?",
    a: "We configure subpages dynamically to target specific suburbs. For example, if you serve Eastern Suburbs, your site will dynamically support dedicated pages for Bondi, Randwick, and Coogee, each with custom local schemas.",
  },
  {
    q: "Is hosting and maintenance included?",
    a: "Yes. We host our websites on ultra-reliable global Edge networks (Netlify/Vercel) with 99.9% uptime and zero maintenance required. You don't have to worry about plugin updates or website security hacks.",
  },
];

const faqSchemaJson = generateFAQSchema(faqItems);
---

<BaseLayout
  title="Ultra-Fast Custom Websites for Plumbers & Tradies | Amberly Digital"
  description="Lightning-fast neobrutalist trade websites. Loads in under 1 second, optimized for mobile lead conversions, and built-in local SEO suburb engines."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchemaJson)} />

  <Navbar />

  <!-- TOP STRIP -->
  <div
    class="bg-amber-500 border-b-2 border-slate-950 py-2.5 px-4 text-center text-slate-950 text-xs font-mono font-black uppercase tracking-widest flex items-center justify-center gap-2"
  >
    <Zap className="w-4 h-4 animate-bounce shrink-0 text-slate-950" />
    <span>LIGHTNING-FAST EDGE COMPILED ASTRO PLATFORM IN PRODUCTION</span>
  </div>

  <main class="bg-white">
    <!-- HERO SECTION: PROBLEM + OUTCOME -->
    <section
      class="border-b-2 border-slate-950 py-16 lg:py-24 bg-slate-50 relative overflow-hidden"
    >
      <div
        class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <div class="max-w-5xl mx-auto px-6 lg:px-12 space-y-8 relative">
        <span
          class="text-xs font-mono font-black text-amber-600 border border-amber-300 bg-amber-100 px-3 py-1 w-fit block uppercase tracking-widest"
        >
          💻 ULTRA-FAST DEVELOPMENT
        </span>
        <h1
          class="text-4xl sm:text-5xl lg:text-7xl font-black font-display text-slate-950 uppercase tracking-tight leading-none"
        >
          Speed Wins. <br />
          <span class="text-amber-500">Conversions Explode.</span>
        </h1>

        <!-- Problem & Outcome Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6">
          <div
            class="border-2 border-slate-900 bg-white p-6 shadow-[4px_4px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="text-[10px] font-mono font-black text-red-500 uppercase tracking-widest block mb-2"
              >✖ THE PROBLEM: SLOW & DISTRACTING WEBSITES</span
            >
            <p class="text-sm text-slate-700 leading-relaxed font-semibold">
              Plumbers buying traffic only to lose it on slow WordPress sites. A
              3-second delay on mobile causes 53% of customers to bounce back to
              the Google search page. Confusing layouts with dozens of pages
              distract customers from doing the one thing that gets jobs booked:
              calling you.
            </p>
          </div>
          <div
            class="border-2 border-amber-500 bg-slate-900 p-6 shadow-[4px_4px_0px_rgba(245,158,11,1)] text-white"
          >
            <span
              class="text-[10px] font-mono font-black text-amber-400 uppercase tracking-widest block mb-2"
              >✔ THE OUTCOME: SUB-SECOND LOAD & HIGH CONVERSIONS</span
            >
            <p class="text-sm text-slate-350 leading-relaxed">
              We compile your website using Astro, serving static files over
              Edge networks that load in under 1 second. Clean, neobrutalist,
              high-contrast layouts direct emergency leads immediately to a
              prominent "Call Dispatcher" trigger, maximizing your conversion
              rates.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS: 3 SIMPLE STEPS -->
    <section class="py-16 lg:py-20 border-b-2 border-slate-950">
      <div class="max-w-5xl mx-auto px-6 lg:px-12">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span
            class="text-xs font-mono font-black text-amber-600 uppercase tracking-widest block mb-2"
            >METHODOLOGY</span
          >
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Three Steps to Sub-Second Speed
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >01</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              Action-First Layout
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              We wireframe a neobrutalist landing page focused entirely on
              emergency response, trust badges, and direct call-out conversions.
            </p>
          </div>
          <!-- Step 2 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >02</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              Astro Engine Build
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              Our developers write your site in code (React/Astro) optimized for
              Edge delivery. There is no WordPress database or heavy template
              bloat.
            </p>
          </div>
          <!-- Step 3 -->
          <div
            class="border-2 border-slate-950 p-6 bg-slate-50 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span
              class="absolute -top-6 left-4 text-7xl font-black font-display text-slate-200/80 select-none pointer-events-none"
              >03</span
            >
            <h3
              class="text-lg font-bold font-display text-slate-950 uppercase tracking-tight mb-2 pt-4"
            >
              Local Schema Hook
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-semibold">
              We configure dynamic suburb routing layers in your site's
              codebase, automatically matching search algorithms to rank in your
              territory.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- EXAMPLE RESULT: LIGHTHOUSE SPEED METRICS & MOBILE WIREFRAME -->
    <section class="py-16 lg:py-20 bg-slate-50 border-b-2 border-slate-950">
      <div
        class="max-w-8xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
      >
        <!-- Text Column -->
        <div class="lg:col-span-5 space-y-6">
          <span
            class="text-xs font-mono font-black text-amber-600 border border-amber-300 bg-amber-100 px-3 py-1 w-fit block uppercase tracking-widest"
          >
            PERFORMANCE PROOF
          </span>
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            How Speed Looks
          </h2>
          <p class="text-sm text-slate-650 leading-relaxed font-medium">
            This panel shows a performance metric scorecard and mobile viewport
            of our neobrutalist structure. Serving raw compiled static code
            translates directly to a 100/100 Lighthouse score—the ultimate green
            signal for Google search ranking crawlers.
          </p>
          <div
            class="p-4 bg-white border border-slate-200 flex items-start gap-3"
          >
            <CheckCircle className="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
            <p class="text-xs text-slate-600">
              <strong>97% conversion increase</strong> documented on edge-compiled
              Astro platforms compared to legacy WordPress sites.
            </p>
          </div>
        </div>

        <!-- Speed Metrics & Viewport Mockup -->
        <div
          class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-12 gap-8 items-stretch"
        >
          {/* Lighthouse Score (5 columns) */}
          <div
            class="sm:col-span-5 bg-slate-900 border-2 border-slate-950 p-6 flex flex-col justify-between shadow-[6px_6px_0px_rgba(0,0,0,1)] text-white"
          >
            <span
              class="text-[9px] font-mono text-slate-500 font-bold block uppercase tracking-widest"
              >GOOGLE LIGHTHOUSE</span
            >
            <div class="my-8 text-center">
              <div
                class="inline-flex items-center justify-center w-28 h-28 rounded-full border-8 border-emerald-500 text-3xl font-mono font-black text-emerald-400"
              >
                100
              </div>
              <span
                class="block text-xs font-mono uppercase text-slate-400 mt-4 tracking-wider"
                >Performance Rating</span
              >
            </div>
            <div
              class="space-y-2 font-mono text-[9px] text-slate-400 border-t border-slate-800 pt-4"
            >
              <div class="flex justify-between">
                <span>FIRST CONTENTFUL PAINT</span><span
                  class="text-emerald-400 font-bold">0.3s</span>
              </div>
              <div class="flex justify-between">
                <span>SPEED INDEX</span><span class="text-emerald-400 font-bold"
                  >0.4s</span>
              </div>
              <div class="flex justify-between">
                <span>TOTAL BLOCKING TIME</span><span
                  class="text-emerald-400 font-bold">0ms</span>
              </div>
            </div>
          </div>

          {/* Mobile Preview Mockup (7 columns) */}
          <div
            class="sm:col-span-7 bg-white border-2 border-slate-950 p-4 shadow-[6px_6px_0px_rgba(0,0,0,1)] flex flex-col justify-between min-h-[300px]"
          >
            <div
              class="border-b border-slate-200 pb-2 mb-4 flex justify-between items-center text-[10px] font-mono text-slate-400"
            >
              <span>📳 MOBILE VIEW PREVIEW</span>
              <Smartphone className="w-3.5 h-3.5" />
            </div>
            {/* Neobrutalist Mobile Header Mockup */}
            <div class="border-2 border-slate-950 p-4 bg-slate-50 space-y-4">
              <div
                class="w-8 h-8 bg-amber-500 border border-slate-950 flex items-center justify-center font-mono font-black text-xs text-slate-950"
              >
                A
              </div>
              <h5
                class="text-base font-black font-display text-slate-950 uppercase leading-none"
              >
                Bondi Emergency Plumbers
              </h5>
              <p class="text-[10px] text-slate-500 leading-normal">
                Blocked sewer, hot water geyser failure, or leak detection.
                Bondi Beach coverage node.
              </p>
              <div
                class="bg-amber-500 border-2 border-slate-950 py-3 text-center text-slate-950 font-mono font-black text-xs uppercase tracking-wider shadow-[2px_2px_0px_rgba(0,0,0,1)] cursor-pointer active:translate-x-0.5 active:translate-y-0.5 transition-all"
              >
                📞 CALL DISPATCHER NOW
              </div>
            </div>
            <div
              class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[8px] font-mono text-slate-400"
            >
              <span>Edge Server Node: Sydney AU</span>
              <span class="text-amber-500 font-bold">● Edge Cache Active</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY TRADIES USE IT: BENEFITS -->
    <section class="py-16 lg:py-24 border-b-2 border-slate-950">
      <div class="max-w-5xl mx-auto px-6 lg:px-12">
        <div class="mb-14 text-center max-w-2xl mx-auto">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >BENEFITS</span
          >
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Structured For Plumbing Conversions
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            service.benefits.map((benefit, idx) => (
              <div class="bg-slate-50 border-2 border-slate-950 p-6 flex items-start gap-4 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
                <div class="w-10 h-10 bg-amber-500 border-2 border-slate-950 text-slate-950 flex items-center justify-center shrink-0 shadow-[2px_2px_0px_rgba(0,0,0,1)]">
                  <span class="font-mono font-black text-xs">0{idx + 1}</span>
                </div>
                <div>
                  <h4 class="text-base font-bold font-display uppercase tracking-tight text-slate-950 mb-2">
                    {service.features[idx]}
                  </h4>
                  <p class="text-xs text-slate-600 leading-relaxed font-semibold">
                    {benefit}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ: SERVICE-SPECIFIC -->
    <section class="py-16 lg:py-20 bg-slate-50 border-b-2 border-slate-950">
      <div class="max-w-3xl mx-auto px-6 lg:px-12">
        <div class="mb-12 text-center">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >FAQ</span
          >
          <h2
            class="text-2xl sm:text-3xl font-black font-display text-slate-950 uppercase tracking-tight"
          >
            Custom Websites FAQ
          </h2>
        </div>

        <div class="space-y-4">
          {
            faqItems.map((faq) => (
              <div class="border-2 border-slate-200 p-5 bg-white shadow-sm">
                <h3 class="text-sm font-black text-slate-950 uppercase tracking-tight mb-2">
                  {faq.q}
                </h3>
                <p class="text-xs text-slate-650 leading-relaxed font-semibold">
                  {faq.a}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA STRIP -->
    <section class="bg-amber-50 py-16 border-b-2 border-slate-950">
      <div
        class="max-w-4xl mx-auto px-6 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-8 text-slate-950"
      >
        <div>
          <h2
            class="text-3xl sm:text-4xl font-black font-display uppercase tracking-tight leading-tight"
          >
            Build a Lightning-Fast<br class="hidden sm:block" /> Web Conversion Engine.
          </h2>
          <p class="text-slate-800 text-sm font-bold mt-2">
            Ditch slow templates. Get a custom compiled Astro asset constructed
            for your trade territory.
          </p>
        </div>
        <a
          href="/#onboarding-form"
          class="shrink-0 bg-white text-slate-950 font-black py-4 px-8 text-xs tracking-widest uppercase transition-all duration-200 border-2 border-slate-950 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 hover:shadow-none"
        >
          Book Strategy Call →
        </a>
      </div>
    </section>

    <!-- REGIONAL CITIES SELECTOR -->
    <section class="py-16">
      <div class="max-w-8xl mx-auto px-6 lg:px-12">
        <div class="max-w-2xl mb-12">
          <span
            class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
            >DYNAMIC REGIONAL DEPLOYMENTS</span
          >
          <h2
            class="text-3xl font-display font-black text-slate-950 uppercase tracking-tight"
          >
            Deploy In Your Capital City
          </h2>
          <p class="text-slate-600 mt-2 text-sm font-medium">
            Select your capital city region to see how we adjust geo-coordinates
            and schema files for your local suburbs.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
          {
            Object.entries(CITIES).map(([cityKey, city]) => (
              <div class="bg-white border-2 border-slate-950 p-6 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3">
                    <span class="text-lg font-black font-display text-slate-900 uppercase">
                      {city.name}
                    </span>
                    <span class="text-[10px] font-mono font-bold bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 uppercase">
                      {city.state}
                    </span>
                  </div>
                  <p class="text-[10px] text-slate-500 font-mono mb-4 leading-normal">
                    Includes suburbs: {city.suburbs.slice(0, 3).join(", ")}...
                  </p>
                </div>
                <a
                  href={`/services/custom-websites/${cityKey}`}
                  class="inline-flex items-center justify-between text-xs font-mono font-black uppercase text-slate-950 hover:text-amber-600 border-t border-slate-100 pt-3"
                >
                  <>
                    <span>Target {city.name}</span>
                    <span>→</span>
                  </>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer client:visible />
</BaseLayout>
