---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Footer } from "@/components/Footer";
import { SERVICES, CITIES } from "@/lib/seo-data";
import {
  Layers,
  Code,
  MessageSquare,
  TrendingUp,
  MapPin,
  ShieldCheck,
  Globe,
  Star,
  Calculator,
  Search,
  Zap,
  Phone,
  FileText,
} from "lucide-react";

const iconMap: Record<string, any> = {
  Layers,
  Code,
  MessageSquare,
  TrendingUp,
  MapPin,
  ShieldCheck,
  Globe,
  Star,
  Calculator,
  Search,
  Zap,
  Phone,
  FileText,
};
---

<BaseLayout
  title="Aussie Trade Growth Services | Amberly Digital SEO & AEO Specialists"
  description="Explore our elite search positioning and Answer Engine Optimization (AEO) solutions for plumbers. Secure Google Maps Top 3 and ChatGPT grounding today."
>
  <Navbar />

  <!-- HEADER BANNER -->
  <header
    class="bg-slate-900 text-white border-b-2 border-slate-950 py-16 relative overflow-hidden"
  >
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center space-y-6 relative">
      <span
        class="text-[10px] font-mono font-black text-amber-400 border border-amber-400/30 bg-amber-500/10 px-3 py-1 tracking-wider uppercase inline-block"
      >
        ⚡ SEARCH & ANSWER ENGINE DOMINANCE SYSTEM
      </span>
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight"
      >
        Our Trade Growth <span class="text-amber-500">Services.</span>
      </h1>
      <p
        class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-semibold"
      >
        We don't do generic marketing. We deploy high-converting search assets,
        citation synchronization layers, and automated SMS responses to turn
        local emergency searches into jobs.
      </p>
    </div>
  </header>

  <!-- SERVICES GRID -->
  <section class="py-16 bg-white border-b-2 border-slate-950">
    <div class="max-w-8xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          Object.entries(SERVICES).map(([slug, s]) => {
            const Icon = iconMap[s.icon] || Layers;
            return (
              <a
                href={`/services/${slug}`}
                class="bg-white border-2 border-slate-950 p-6 flex flex-col justify-between transition-all duration-300 group min-h-[185px] rounded-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[4px_4px_0px_0px_rgba(245,158,11,1)] hover:-translate-x-0.5 hover:-translate-y-0.5"
              >
                <div>
                  <h3 class="text-xl font-bold text-slate-950 tracking-tight leading-tight flex items-center gap-2 uppercase font-display">
                    <Icon className="w-5 h-5 text-amber-500 shrink-0" />
                    {s.title}
                  </h3>
                  <p class="text-xs text-slate-600 mt-3 leading-relaxed font-semibold">
                    {s.shortDesc}
                  </p>
                </div>
                <div class="mt-6 flex items-center justify-between pt-4 border-t border-slate-200">
                  <span class="text-[10px] font-mono font-bold text-slate-500 group-hover:text-slate-800 transition-colors uppercase tracking-widest">
                    Explore Service
                  </span>
                  <svg
                    class="w-5 h-5 text-slate-400 group-hover:text-slate-800 transition-all group-hover:translate-x-1.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- LOCALIZED SEO COVERAGE INDEX -->
  <section class="py-16 bg-slate-50 border-b-2 border-slate-950">
    <div class="max-w-8xl mx-auto px-6 lg:px-12">
      <div class="max-w-2xl mb-12">
        <span
          class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest block mb-2"
          >LOCALIZED DEPLOYMENT Radials</span
        >
        <h2
          class="text-3xl font-display font-black text-slate-900 uppercase tracking-tight"
        >
          Select Your Metro Area For Targeted Schemas
        </h2>
        <p class="text-slate-600 mt-2 text-sm font-medium">
          We configure precise location coordinates and postal coverage areas to
          ground AI crawlers and rank your plumbing business in your local
          capital city.
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {
          Object.entries(CITIES).map(([cityKey, city]) => (
            <div class="bg-white border-2 border-slate-950 p-4 shadow-[2px_2px_0px_rgba(0,0,0,1)]">
              <span class="text-xs font-mono font-black uppercase text-slate-400 block mb-1">
                {city.state} Region
              </span>
              <span class="text-base font-black font-display text-slate-900 block mb-3 uppercase">
                {city.name}
              </span>
              <div class="flex flex-col gap-1 border-t border-slate-100 pt-2 text-[10px] font-mono">
                <a
                  href={`/services/local-suburb-micro-funnels/${cityKey}`}
                  class="hover:underline text-slate-600 hover:text-amber-600"
                >
                  → Suburb Funnels
                </a>
                <a
                  href={`/services/advanced-json-ld-markups/${cityKey}`}
                  class="hover:underline text-slate-600 hover:text-amber-600"
                >
                  → JSON-LD Markups
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Footer client:visible />
</BaseLayout>
