---
// PERF_OPT: Enabled static prerendering to drastically improve FCP and LCP. Remove if SSR is needed.
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { Footer } from "@/components/Footer";
import { ValuationCalculator } from "@/components/ValuationCalculator";
import { EmergencyScanner } from "@/components/EmergencyScanner";
import { LeadCommandCenter } from "@/components/LeadCommandCenter";
import { AreaPartnerBooking } from "@/components/AreaPartnerBooking";
---

<BaseLayout
  title="Free Plumber Growth Tools | Suburb Visibility Scanner, Revenue Calculator & SMS Bot"
  description="Free tools for Australian plumbing trade businesses. Check your suburb search visibility, calculate missed call revenue, and test our AI SMS auto-responder."
>
  <Navbar />

  <!-- EMERGENCY NOTIFICATION HEADLINE STICKER BANNER -->
  <div
    class="bg-amber-500 border-b-2 border-slate-950 py-2.5 px-4 text-center text-slate-950 text-xs font-mono font-black uppercase tracking-widest flex items-center justify-center gap-2 flex-wrap"
  >
    <svg
      class="w-4 h-4 text-slate-950 fill-current animate-bounce"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      ><path
        d="M17.66 11.2C17.43 10.9 17.15 10.64 16.89 10.38C16.22 9.78 15.46 9.35 14.82 8.72C13.33 7.26 13 4.85 13.95 3C13 3.23 12.17 3.75 11.46 4.32C8.87 6.4 7.85 10.07 9.07 13.22C9.11 13.32 9.15 13.42 9.15 13.55C9.15 13.77 9 13.97 8.8 14.05C8.57 14.15 8.33 14.09 8.14 13.93C8.08 13.88 8.04 13.83 8 13.76C6.87 12.33 6.69 10.28 7.45 8.64C5.78 10 4.87 12.3 5 14.47C5.06 14.97 5.12 15.47 5.29 15.97C5.43 16.57 5.7 17.17 6 17.7C7.08 19.43 8.95 20.67 10.96 20.92C13.1 21.19 15.39 20.8 17.03 19.32C18.86 17.66 19.5 15 18.56 12.72L18.43 12.46C18.22 12 17.66 11.2 17.66 11.2Z"
      ></path></svg
    >
    <span
      >PROMOTION: Free Suburb Exclusivity Audits currently active for NSW, VIC,
      and QLD. Check your target trade suburb below!</span
    >
  </div>

  <!-- TOOLS HERO BANNER -->
  <header
    class="bg-slate-900 text-white border-b-2 border-slate-950 py-16 relative overflow-hidden"
  >
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center space-y-6 relative">
      <span
        class="text-[10px] font-mono font-black text-amber-400 border border-amber-400/30 bg-amber-500/10 px-3 py-1 tracking-wider uppercase inline-block"
      >
        🛠️ PLUMBER GROWTH TOOLS SUITE
      </span>
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight"
      >
        Plug Lead Leakage. <span class="text-amber-500"
          >Dominate Local Search.</span
        >
      </h1>
      <p
        class="text-slate-355 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-semibold"
      >
        Evaluate your plumbing business metrics instantly. Check your live
        Google/ChatGPT visibility, calculate weekly lost revenue, and experience
        our instant SMS responder.
      </p>
    </div>
  </header>

  <!-- SECTION 1: CALCULATOR -->
  <section id="calculator" class="py-16 bg-white border-b-2 border-slate-950">
    <div
      class="max-w-8xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch"
    >
      <div class="lg:col-span-7 flex flex-col justify-center space-y-6">
        <span
          class="text-xs font-mono font-black text-amber-600 uppercase tracking-widest border border-amber-300 bg-amber-50 px-3 py-1 w-fit block font-bold"
          >01 / Profit Leakage Calculator</span
        >
        <h2
          class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight leading-none"
        >
          Emergency Calls Missed Revenue Calculator
        </h2>
        <p class="text-slate-650 text-sm leading-relaxed font-semibold">
          Plumbing emergencies occur 24/7. When pipes burst or hot water systems
          fail, homeowners call the first available number on Google Maps or
          Siri.
        </p>
        <p class="text-xs text-slate-500 leading-relaxed">
          If you miss that call because you are driving, asleep, or working on
          another job, they hang up and dial your competitor in seconds. This
          calculator simulates the minimum weekly revenue leaked based on median
          Australian emergency job rates ($750 AUD).
        </p>
        <div class="p-5 border-l-4 border-amber-500 bg-slate-50">
          <span
            class="font-mono text-xs font-black uppercase text-slate-900 block mb-1"
            >How to plug this leak:</span
          >
          <p class="text-xs text-slate-500">
            Deploying automatic SMS textbacks guarantees immediate engagement,
            securing the job dispatch before the caller moves to the next
            listing.
          </p>
        </div>
      </div>
      <ValuationCalculator client:load />
    </div>
  </section>

  <!-- SECTION 2: SEARCH SCANNER -->
  <section
    id="visibility-scan"
    class="py-16 bg-slate-50 border-b-2 border-slate-950"
  >
    <div class="max-w-8xl mx-auto px-6 lg:px-12 space-y-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <span
            class="text-xs font-mono font-black text-amber-600 uppercase tracking-widest border border-amber-300 bg-amber-50 px-3 py-1 w-fit block mb-3 font-bold"
            >02 / Local SEO & AEO Analysis</span
          >
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight leading-none"
          >
            Emergency Search Visibility Scanner
          </h2>
          <p class="text-slate-650 text-sm mt-2 leading-relaxed font-medium">
            Run a real-time check of your suburb rankings. Our scanner evaluates
            your Google Business Profile local pack status and validates if AI
            search engines (like ChatGPT or voice assistant models) recommend
            your business for plumbing emergencies.
          </p>
        </div>
        <span
          class="text-[10px] font-mono bg-slate-200 text-slate-700 px-3 py-1.5 border border-slate-300 font-bold uppercase tracking-widest h-fit shrink-0"
          >⚡ Real-time API Integration</span
        >
      </div>
      <!-- PERF_OPT: Changed client:load to client:visible to defer loading. Change back to client:load if needed. -->
      <EmergencyScanner client:visible />
    </div>
  </section>

  <!-- SECTION 3: SMS RESPONDER -->
  <section
    id="sms-responder"
    class="py-16 bg-white border-b-2 border-slate-950"
  >
    <div class="max-w-8xl mx-auto px-6 lg:px-12 space-y-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <span
            class="text-xs font-mono font-black text-amber-600 uppercase tracking-widest border border-amber-300 bg-amber-50 px-3 py-1 w-fit block mb-3 font-bold"
            >03 / Lead-Capture Auto Responder</span
          >
          <h2
            class="text-3xl sm:text-4xl font-display font-black text-slate-950 uppercase tracking-tight leading-none"
          >
            24/7 AI FAST SMS Responder Simulator
          </h2>
          <p class="text-slate-650 text-sm mt-2 leading-relaxed font-medium">
            Test out our instant callback and text responder bot. See how
            quickly our AI responds to emergency requests, gathers customer
            details, and secures the dispatch booking.
          </p>
        </div>
        <div class="flex items-center gap-2 h-fit shrink-0">
          <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"
          ></span>
          <span
            class="text-xs font-mono font-black text-slate-750 uppercase tracking-widest"
            >Live Bot Active</span
          >
        </div>
      </div>
      <!-- PERF_OPT: Changed client:load to client:visible to defer loading. Change back to client:load if needed. -->
      <LeadCommandCenter client:visible />
    </div>
  </section>

  <!-- Area Booking Section -->
  <AreaPartnerBooking client:visible />

  <Footer client:visible />
</BaseLayout>
